# Runtime receipt evidence is retained by the deployed instance, never committed.
App_Data/receipts/*
!App_Data/receipts/.gitkeep
App_Data/fallback-evidence-*/
App_Data/ollama-policy-regression-*/
App_Data/gpu-evidence-*/

# Build, IDE, publish and local runtime output.
bin/
obj/
publish/
.vs/
.tmp/
*.user
*.suo
*.log
TestResults/

# Legacy/runtime upload folders must never be published from wwwroot.
wwwroot/uploads/
wwwroot/temp_test/

# Optional private evaluation photos: keep instructions, never commit the receipts themselves.
test_kit/local_real/*
!test_kit/local_real/README.md
test_kit/results/

# Secrets and machine-specific production settings must never enter Git.
appsettings.Secrets.json
appsettings.Production.local.json
*.publishsettings
*.pubxml.user

# Large demo recordings are hosted externally; the versioned script lives in docs/.
submission/*.mp4
submission/*.mov
submission/*.mkv

# Private study, pitch and competition-strategy material lives in D:/aura/phan_bien.
# Keep the public repository limited to product, verification and submission artifacts.
docs/AURA_FINAL_DEFENSE_SOURCE_CODE_QA_*.md
docs/AURA_FINAL_PITCH_AND_JUDGE_QA_*.md
docs/AURA_FINAL_STUDY_GUIDE_*.md
docs/*STUDY_PLAN*.md
docs/BTC_GPU_*_RUNBOOK_*.md
docs/ONSITE_FINAL_PLAYBOOK_*.md
docs/PERSONAL_*.md
