@{
    ViewData["Title"] = "Verify Harness";
}

<div class="hero-band" style="padding: 40px 0; margin-bottom: 24px;">
    <div class="container" style="max-width: 1100px;">
        <h2 class="hero-title" style="font-size: 2.5rem;">Verify Harness (Automated Audit)</h2>
        <p class="hero-subtitle">Chạy hệ thống kiểm thử tự động với 5 ca Canonical (Track A).</p>
    </div>
</div>

<div class="container" style="max-width: 1100px;">
    <div class="feature-card mb-4" style="text-align: center; padding: 24px;">
        <form asp-controller="Verify" asp-action="RunHarness" method="post" id="verifyForm">
            <button type="button" class="button-primary" id="runTestsBtn" style="font-size: 16px; padding: 12px 24px;" onclick="runTests()">
                <span id="btnText">Run 5 Canonical Cases</span>
                <div class="spinner-border spinner-border-sm ms-2" role="status" id="loadingSpinner" style="display: none;">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </button>
        </form>
    </div>

    <div class="feature-card" id="resultsContainer" style="display:none; overflow-x: auto; position: relative;">
        <div id="loadingOverlay" class="loading-overlay" style="display: none;">
            <div class="text-center">
                <div class="spinner-border mb-3" style="width: 3rem; height: 3rem; color: var(--colors-primary);" role="status"></div>
                <h5 style="color: var(--colors-ink);">AI đang đọc hóa đơn...</h5>
                <p style="color: var(--colors-body);">Vui lòng chờ trong giây lát.</p>
            </div>
        </div>

        <table class="table-aura">
            <thead>
                <tr>
                    <th>Case ID</th>
                    <th>Image</th>
                    <th>Expected</th>
                    <th>Actual</th>
                    <th>PASS/FAIL</th>
                    <th>Reasoning</th>
                    <th>Latency</th>
                </tr>
            </thead>
            <tbody id="resultsBody">
            </tbody>
        </table>
    </div>
</div>

<script>
    async function runTests() {
        // Show Loading UI
        document.getElementById('runTestsBtn').disabled = true;
        document.getElementById('btnText').innerText = 'Đang chạy kiểm thử...';
        document.getElementById('loadingSpinner').style.display = 'inline-block';
        
        document.getElementById('resultsContainer').style.display = 'block';
        document.getElementById('loadingOverlay').style.display = 'flex';
        document.getElementById('resultsBody').innerHTML = '';
        
        const form = document.getElementById('verifyForm');
        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData
            });

            const data = await response.json();
            let html = '';
            data.forEach(item => {
                const passBadge = item.pass ? '<span class="status-badge approve">PASS</span>' : '<span class="status-badge escalate">FAIL</span>';
                const expectedBadge = item.expected === 'AUTO_APPROVE' ? '<span class="status-badge approve">APPROVE</span>' : '<span class="status-badge escalate">ESCALATE</span>';
                const actualBadge = item.actual === 'AUTO_APPROVE' ? '<span class="status-badge approve">APPROVE</span>' : '<span class="status-badge escalate">ESCALATE</span>';
                
                html += <tr>
                    <td style="font-family: monospace;"> + item.caseId + </td>
                    <td> + item.image + </td>
                    <td> + expectedBadge + </td>
                    <td> + actualBadge + </td>
                    <td> + passBadge + </td>
                    <td><strong style="color: var(--colors-ink);"> + item.reason + </strong><br/><small style="color: var(--colors-muted);"><i> + (item.question || '') + </i></small></td>
                    <td style="font-family: monospace; color: var(--colors-muted);"> + item.latencyMs +  ms</td>
                </tr>;
            });
            document.getElementById('resultsBody').innerHTML = html;
        } catch(e) {
            document.getElementById('resultsBody').innerHTML = '<tr><td colspan="7" class="text-danger text-center">Có lỗi xảy ra: ' + e.message + '</td></tr>';
        } finally {
            // Hide Loading UI
            document.getElementById('runTestsBtn').disabled = false;
            document.getElementById('btnText').innerText = 'Run 5 Canonical Cases';
            document.getElementById('loadingSpinner').style.display = 'none';
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    }
</script>
