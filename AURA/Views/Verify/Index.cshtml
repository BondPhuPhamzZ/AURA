@{
    ViewData["Title"] = "Verify Harness";
}

<div class="hero-band" style="padding: 40px 0; margin-bottom: 24px;">
    <h2 class="hero-title" style="font-size: 2.5rem;">Verify Harness (Automated Audit)</h2>
    <p class="hero-subtitle">Chạy hệ thống kiểm thử tự động với 5 ca Canonical (Track A).</p>
</div>

<div class="container" style="max-width: 1100px;">
    <div class="feature-card mb-4" style="text-align: center; padding: 24px;">
        <form asp-controller="Verify" asp-action="RunHarness" method="post" id="verifyForm">
            <button type="button" class="button-primary" style="font-size: 16px; padding: 12px 24px;" onclick="runTests()">Run 5 Canonical Cases</button>
        </form>
    </div>

    <div class="feature-card" id="resultsContainer" style="display:none; overflow-x: auto;">
        <table class="table-aura">
            <thead>
                <tr>
                    <th>Case ID</th>
                    <th>Image</th>
                    <th>Expected</th>
                    <th>Actual</th>
                    <th>PASS/FAIL</th>
                    <th>Reasoning</th>
                    <th>Latency</th>
                </tr>
            </thead>
            <tbody id="resultsBody">
            </tbody>
        </table>
    </div>
</div>

<script>
    async function runTests() {
        document.getElementById('resultsContainer').style.display = 'block';
        document.getElementById('resultsBody').innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--colors-body);">Running tests... Please wait.</td></tr>';
        
        const form = document.getElementById('verifyForm');
        const formData = new FormData(form);

        const response = await fetch(form.action, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();
        let html = '';
        data.forEach(item => {
            const passBadge = item.pass ? '<span class="status-badge approve">PASS</span>' : '<span class="status-badge escalate">FAIL</span>';
            const expectedBadge = item.expected === 'AUTO_APPROVE' ? '<span class="status-badge approve">APPROVE</span>' : '<span class="status-badge escalate">ESCALATE</span>';
            const actualBadge = item.actual === 'AUTO_APPROVE' ? '<span class="status-badge approve">APPROVE</span>' : '<span class="status-badge escalate">ESCALATE</span>';
            
            html += <tr>
                <td style="font-family: monospace;"> + item.caseId + </td>
                <td> + item.image + </td>
                <td> + expectedBadge + </td>
                <td> + actualBadge + </td>
                <td> + passBadge + </td>
                <td> + item.reason + <br/><small style="color: var(--colors-body);"><i> + (item.question || '') + </i></small></td>
                <td style="font-family: monospace;"> + item.latencyMs +  ms</td>
            </tr>;
        });
        document.getElementById('resultsBody').innerHTML = html;
    }
</script>
