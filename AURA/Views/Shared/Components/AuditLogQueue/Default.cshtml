@model IEnumerable<AURA.ViewModels.AuditEntryViewModel>

<div class="audit-log-queue">
    <h4 class="mb-2 form-header">Nhật Ký Kiểm Toán</h4>
    <p class="text-muted mb-4">Mỗi dòng ghi rõ thao tác, thời gian, hồ sơ đầu vào và lý do. Quyết định của quản lý có thể được hoàn tác.</p>

    <div class="audit-filter" role="search" aria-label="Lọc lịch sử theo ngày">
        <div class="audit-filter-field">
            <label for="auditDateFrom">Từ ngày</label>
            <input id="auditDateFrom" class="audit-date-input" type="date" />
        </div>
        <div class="audit-filter-field">
            <label for="auditDateTo">Đến ngày</label>
            <input id="auditDateTo" class="audit-date-input" type="date" />
        </div>
        <button type="button" id="auditFilterReset" class="button-ghost-sm audit-filter-reset">Xóa bộ lọc</button>
        <span id="auditFilterResult" class="audit-filter-result" role="status" aria-live="polite"></span>
    </div>

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger feature-card" style="padding: 16px;">@loadError</div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info feature-card" style="padding: 16px;">Chưa có dữ liệu lịch sử.</div>
    }
    else
    {
        <div class="table-responsive-aura table-scroll-area table-scroll-area-tall">
            <table class="table-aura audit-table">
                <colgroup>
                    <col class="audit-col-time" />
                    <col class="audit-col-id" />
                    <col class="audit-col-action" />
                    <col class="audit-col-status" />
                    <col class="audit-col-input" />
                    <col class="audit-col-details" />
                    <col class="audit-col-intervention" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Thời Gian</th>
                        <th>Mã Đơn</th>
                        <th>Thao Tác</th>
                        <th>Trạng Thái Hiện Tại</th>
                        <th>Dữ Liệu Đầu Vào</th>
                        <th>Chi Tiết / Lý Do</th>
                        <th>Can Thiệp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        var request = entry.Request;
                        var detailParts = (entry.Log.Details ?? string.Empty)
                            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        var actionLabel = entry.Log.Action switch
                        {
                            "MANAGER_YES" => "Quản lý duyệt",
                            "MANAGER_APPROVE" => "Quản lý duyệt",
                            "MANAGER_NO" => "Quản lý từ chối",
                            "MANAGER_REJECT" => "Quản lý từ chối",
                            "MANAGER_UNDO" => "Hoàn tác quyết định",
                            "EMPLOYEE_FORWARDED_TO_MANAGER" => "Chuyển quản lý",
                            "AUTO_APPROVE" => "Tự động duyệt",
                            "AI_ANALYZED" => "AI thẩm định",
                            _ when entry.Log.Action.StartsWith("AI_PROCESSED_", StringComparison.Ordinal) => "AI thẩm định",
                            _ when entry.Log.Action.StartsWith("VERIFY_", StringComparison.Ordinal) => "Verify Harness",
                            _ => entry.Log.Action.Replace('_', ' ')
                        };
                        var localTimestamp = entry.Log.Timestamp.ToLocalTime();
                        <tr class="audit-data-row" data-audit-date="@localTimestamp.ToString("yyyy-MM-dd")">
                            <td class="audit-time-cell">
                                <time datetime="@entry.Log.Timestamp.ToString("O")">
                                    <span>@localTimestamp.ToString("dd/MM/yyyy")</span>
                                    <small>@localTimestamp.ToString("HH:mm:ss")</small>
                                </time>
                            </td>
                            <td class="cell-code">@entry.Log.RequestId[..Math.Min(8, entry.Log.RequestId.Length)]</td>
                            <td><span class="badge bg-secondary audit-action-badge" title="Mã thao tác: @entry.Log.Action">@actionLabel</span></td>
                            <td>
                                @if (request is not null)
                                {
                                    var badgeClass = request.Status == "AUTO_APPROVE" ? "bg-success"
                                        : request.Status.StartsWith("ESCALATE_", StringComparison.Ordinal) ? "bg-warning text-dark"
                                        : request.ManagerAnswer == true ? "bg-success"
                                        : request.ManagerAnswer == false ? "bg-danger"
                                        : "bg-secondary";
                                    <span class="badge @badgeClass">@request.Status</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không còn hồ sơ</span>
                                }
                            </td>
                            <td>
                                @if (request is not null && !string.IsNullOrWhiteSpace(request.ImageUrl))
                                {
                                    <a href="@request.ImageUrl" target="_blank" rel="noopener">@request.OriginalFileName</a>
                                    <div><small>@request.ClaimedAmount.ToString("N0") VND</small></div>
                                }
                                else
                                {
                                    <span class="text-muted">Không khả dụng</span>
                                }
                            </td>
                            <td>
                                <details class="audit-details">
                                    <summary>
                                        <span class="audit-details-preview">
                                            @foreach (var detail in detailParts.Take(3))
                                            {
                                                <span class="audit-detail-line">@detail</span>
                                            }
                                        </span>
                                        <span class="audit-details-toggle"></span>
                                    </summary>
                                    <ul class="audit-details-full">
                                        @foreach (var detail in detailParts)
                                        {
                                            <li>@detail</li>
                                        }
                                    </ul>
                                </details>
                            </td>
                            <td>
                                @if (request is not null && entry.Log.Action is "MANAGER_YES" or "MANAGER_NO"
                                    && AURA.Services.EscalationWorkflow.CanUndo(request.Status) && request.ManagerAnswer is not null)
                                {
                                    <form asp-controller="Reviewer" asp-action="EscalateAction" method="post" class="js-workflow-form">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <input type="hidden" name="decision" value="UNDO" />
                                        <button type="submit" class="button-ghost-sm">Hoàn tác</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr id="auditNoFilterResults" hidden>
                        <td colspan="7" class="text-center empty-state">Không có bản ghi trong khoảng thời gian đã chọn.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    window.initializeAuditFilter = () => {
        const fromInput = document.getElementById('auditDateFrom');
        const toInput = document.getElementById('auditDateTo');
        const resetButton = document.getElementById('auditFilterReset');
        const resultText = document.getElementById('auditFilterResult');
        const emptyRow = document.getElementById('auditNoFilterResults');
        const rows = Array.from(document.querySelectorAll('.audit-data-row'));

        if (!fromInput || !toInput || !resetButton || !resultText || !emptyRow) return;

        function applyAuditDateFilter() {
            const from = fromInput.value;
            const to = toInput.value;
            let visibleCount = 0;

            toInput.min = from;
            fromInput.max = to;

            rows.forEach(row => {
                const date = row.dataset.auditDate || '';
                const isVisible = (!from || date >= from) && (!to || date <= to);
                row.hidden = !isVisible;
                if (isVisible) visibleCount++;
            });

            emptyRow.hidden = visibleCount !== 0;
            resultText.textContent = `${visibleCount}/${rows.length} bản ghi`;
        }

        fromInput.addEventListener('change', applyAuditDateFilter);
        toInput.addEventListener('change', applyAuditDateFilter);
        resetButton.addEventListener('click', () => {
            fromInput.value = '';
            toInput.value = '';
            applyAuditDateFilter();
        });
        applyAuditDateFilter();
    };
    window.initializeAuditFilter();
</script>
