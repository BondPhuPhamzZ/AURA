@model AURA.ViewModels.DashboardSummaryViewModel

<section class="dashboard-summary" aria-labelledby="dashboard-title">
    <div class="dashboard-heading">
        <div class="dashboard-title-group">
            <h2 id="dashboard-title">Tổng quan xử lý @Model.PeriodLabel</h2>
            @if (Model.IsAvailable)
            {
                <form method="get" asp-controller="Home" asp-action="Index" class="dashboard-period-form">
                    <input type="hidden" name="tab" value="dashboard" />
                    <label for="dashboardPeriod">Kỳ báo cáo</label>
                    <input id="dashboardPeriod" name="dashboardPeriod" type="month"
                           value="@($"{Model.SelectedYear:0000}-{Model.SelectedMonth:00}")"
                           min="2000-01" max="2100-12" onchange="this.form.submit()" />
                </form>
            }
        </div>
        <div class="dashboard-actions">
            @if (Model.IsAvailable)
            {
                <a class="button-ghost-sm" asp-controller="Reports" asp-action="CurrentMonth"
                   asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                   title="Tải dữ liệu vận hành của kỳ đang chọn, không gồm raw AI facts">Tải CSV kỳ này</a>
            }
            <a class="button-ghost-sm dashboard-refresh-button" asp-controller="Home" asp-action="Index"
               asp-route-tab="dashboard"
               asp-route-dashboardPeriod="@($"{Model.SelectedYear:0000}-{Model.SelectedMonth:00}")"
               title="Tải lại dữ liệu" aria-label="Tải lại dữ liệu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5"/></svg>
            </a>
        </div>
    </div>

    @if (!Model.IsAvailable)
    {
        <div class="dashboard-error-state" role="alert">
            <strong>Dữ liệu tổng quan tạm thời không khả dụng.</strong>
            <span>@(ViewData["LoadError"] as string ?? "Hãy kiểm tra kết nối cơ sở dữ liệu rồi tải lại.")</span>
            <span>Không dùng các giá trị 0 thay cho dữ liệu chưa tải được.</span>
        </div>
    }
    else
    {
        <div class="dashboard-metrics" aria-label="Chỉ số tháng">
            <div><span>Tiếp nhận</span><strong>@Model.Received</strong></div>
            <div><span>Đã kết thúc</span><strong>@Model.Completed</strong></div>
            <div><span>Tự động duyệt</span><strong>@Model.AutoApproved</strong></div>
            <div><span>Cần người xử lý</span><strong>@Model.Escalated</strong></div>
            <div><span>Cần kiểm tra dữ liệu cá nhân</span><strong>@Model.PrivacyReview</strong></div>
            <div><span>Lỗi hệ thống</span><strong>@Model.Failed</strong></div>
        </div>

        <div class="dashboard-secondary-metrics">
            <span>Tổng tiền tham chiếu: <strong>@Model.TotalAmountVnd.ToString("N0") VND</strong> (không phải tổng đã phê duyệt)</span>
            <span>Độ trễ trung bình hồ sơ đã kết thúc: <strong>@(Model.AverageLatencyMs == 0 ? "Chưa có dữ liệu" : $"{Model.AverageLatencyMs:N0} ms")</strong></span>
        </div>

        <div class="dashboard-year-summary" aria-label="Tổng hợp năm">
            <strong>@Model.YearLabel</strong>
            <span>@Model.YearReceived hồ sơ tiếp nhận</span>
            <span>@Model.YearCompleted hồ sơ đã kết thúc</span>
            <span>@Model.YearTotalAmountVnd.ToString("N0") VND tham chiếu</span>
        </div>

        <div class="table-responsive-aura table-scroll-area dashboard-table-scroll">
            <table class="table-aura dashboard-table">
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th>Tiếp nhận</th>
                    <th>Đã kết thúc</th>
                    <th>Tự động duyệt</th>
                    <th>Cần xử lý</th>
                    <th>Dữ liệu cá nhân</th>
                    <th>Lỗi</th>
                    <th>Tiền tham chiếu</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Days.Count == 0)
            {
                <tr><td colspan="8" class="text-center empty-state">Chưa có hồ sơ trong tháng này.</td></tr>
            }
            else
            {
                foreach (var day in Model.Days)
                {
                    <tr>
                        <td>@day.Date.ToString("dd/MM/yyyy")</td>
                        <td>@day.Received</td>
                        <td>@day.Completed</td>
                        <td>@day.AutoApproved</td>
                        <td>@day.Escalated</td>
                        <td>@day.PrivacyReview</td>
                        <td>@day.Failed</td>
                        <td>@day.TotalAmountVnd.ToString("N0") VND</td>
                    </tr>
                }
            }
            </tbody>
            </table>
        </div>

        <h3 class="dashboard-subtitle">Đối chiếu theo tháng trong @Model.YearLabel.ToLowerInvariant()</h3>
        <div class="table-responsive-aura table-scroll-area dashboard-table-scroll">
            <table class="table-aura dashboard-table">
            <thead>
                <tr>
                    <th>Tháng</th><th>Tiếp nhận</th><th>Đã kết thúc</th><th>Tự động duyệt</th>
                    <th>Cần xử lý</th><th>Dữ liệu cá nhân</th><th>Lỗi</th><th>Tiền tham chiếu</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Months.Count == 0)
            {
                <tr><td colspan="8" class="text-center empty-state">Chưa có hồ sơ trong năm này.</td></tr>
            }
            else
            {
                foreach (var month in Model.Months)
                {
                    <tr>
                        <td>@($"{month.Month:00}/{month.Year}")</td><td>@month.Received</td><td>@month.Completed</td>
                        <td>@month.AutoApproved</td><td>@month.Escalated</td><td>@month.PrivacyReview</td>
                        <td>@month.Failed</td><td>@month.TotalAmountVnd.ToString("N0") VND</td>
                    </tr>
                }
            }
            </tbody>
            </table>
        </div>
    }
</section>
