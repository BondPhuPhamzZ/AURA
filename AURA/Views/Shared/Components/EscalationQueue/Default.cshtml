@model IEnumerable<AURA.Models.ReimbursementRequest>

<div class="escalation-queue">
    <h4 class="mb-4 form-header">Danh Sách Cần Sếp Duyệt</h4>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info feature-card" style="padding: 16px;">Hiện không có ca nào cần duyệt.</div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="table-aura">
                <thead>
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Nhân Viên</th>
                        <th>Số Tiền</th>
                        <th>Lý do từ AI</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Where(m => m.Status == "ESCALATE"))
                    {
                        <tr>
                            <td style="font-family: monospace;">@item.Id.Substring(0, 8)...</td>
                            <td style="font-weight: 500;">@item.EmployeeName</td>
                            <td style="font-weight: 500;">@item.ClaimedAmount.ToString("N0") VND</td>
                            <td><span style="color: #b91c1c;">@item.AiReasoning</span></td>
                            <td>
                                <form asp-controller="Reviewer" asp-action="EscalateAction" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="decision" value="APPROVE" />
                                    <button type="submit" class="button-ghost-sm success">Duyệt Bỏ Qua</button>
                                </form>
                                <form asp-controller="Reviewer" asp-action="EscalateAction" method="post" class="d-inline" style="margin-left: 8px;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="decision" value="REJECT" />
                                    <button type="submit" class="button-ghost-sm danger">Từ Chối</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
