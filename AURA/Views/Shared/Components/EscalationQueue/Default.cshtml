@model AURA.ViewModels.ManagerQueueViewModel

<div class="escalation-queue">
    <div class="manager-queue-heading">
        <h4 class="form-header">Hồ sơ chờ quản lý duyệt</h4>
        @if (ViewData["LoadError"] is null && Model.Items.Count > 0)
        {
            <div class="review-sla-summary" role="status">
                <span class="review-sla-count">@Model.Items.Count hồ sơ đang chờ</span>
                @if (Model.OverdueCount > 0)
                {
                    <span class="review-sla-overdue">@Model.OverdueCount quá @Model.TargetHours giờ</span>
                }
            </div>
        }
    </div>
    <p class="review-sla-note">Sắp xếp theo thời điểm chuyển tiếp, ca chờ lâu nhất ở trên. Mốc @Model.TargetHours giờ chỉ để ưu tiên xử lý; hệ thống không tự duyệt hay từ chối khi quá hạn.</p>
    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger feature-card" style="padding: 16px;" data-fragment-error>@loadError</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="alert alert-info feature-card" style="padding: 16px;">Hiện không có ca nào cần duyệt.</div>
    }
    else
    {
        <div class="table-responsive-aura table-scroll-area">
            <table class="table-aura manager-table responsive-cards">
                <thead>
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Thời gian chờ</th>
                        <th>Nhân Viên</th>
                        <th>Số tiền</th>
                        <th>Lý do từ AI</th>
                        <th>Chứng Từ</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Items)
                    {
                        var item = entry.Request;
                        var choices = AURA.Services.EscalationWorkflow.ExplainChoices(item.Status);
                        <tr class="@(entry.IsOverdue ? "review-overdue" : null)">
                            <td data-label="Mã đơn" class="cell-code">@item.Id[..Math.Min(8, item.Id.Length)]</td>
                            <td data-label="Thời gian chờ">
                                <div class="review-wait">
                                    @if (entry.Waited is { } waited)
                                    {
                                        <strong>
                                            @AURA.Services.ReviewSlaPolicy.FormatWait(waited)
                                            @if (entry.IsOverdue)
                                            {
                                                <span class="badge bg-danger">Quá hạn</span>
                                            }
                                        </strong>
                                        <small>Chuyển lúc @AURA.Services.DisplayFormat.DateTime(entry.ForwardedAtVietnam!.Value)</small>
                                    }
                                    else
                                    {
                                        <small>Chưa rõ thời điểm chuyển tiếp</small>
                                    }
                                </div>
                            </td>
                            <td data-label="Nhân viên">
                                <div class="manager-submitter">
                                    <strong>@item.SubmitterDisplayName</strong>
                                    <span>@item.SubmitterCode</span>
                                    <small>@item.SubmitterDepartment</small>
                                </div>
                            </td>
                            <td data-label="Số tiền" style="font-weight: 500;">@AURA.Services.DisplayFormat.Vnd(item.ClaimedAmount)</td>
                            <td data-label="Lý do từ AI" class="manager-reason-column">
                                <span class="badge bg-warning text-dark">@item.Status</span><br />
                                <span class="manager-ai-reason">@item.AiReasoning</span><br />
                                <small class="manager-question">@item.ManagerQuestion</small>
                            </td>
                            <td data-label="Chứng từ">
                                <a class="receipt-preview-link" href="@item.ImageUrl" target="_blank" rel="noopener">
                                    <img class="receipt-thumbnail receipt-thumbnail-large" src="@item.ImageUrl" alt="Ảnh chứng từ @item.OriginalFileName" loading="lazy" />
                                    <span>Xem hóa đơn</span>
                                </a>
                            </td>
                            <td data-label="Hành động" class="manager-action-column">
                                <form asp-controller="Reviewer" asp-action="EscalateAction" method="post" class="d-inline js-workflow-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="decision" value="YES" />
                                    <button type="submit" class="button-ghost-sm success" title="@choices.Yes">Đồng ý duyệt</button>
                                </form>
                                <form asp-controller="Reviewer" asp-action="EscalateAction" method="post" class="d-inline js-workflow-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="decision" value="NO" />
                                    <button type="submit" class="button-ghost-sm danger" title="@choices.No">Từ chối duyệt</button>
                                </form>
                                <div class="decision-help decision-help-success"><small><strong>Đồng ý:</strong> @choices.Yes</small></div>
                                <div class="decision-help decision-help-danger"><small><strong>Từ chối:</strong> @choices.No</small></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
