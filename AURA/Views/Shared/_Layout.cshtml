<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AURA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="aura-header">
        <a asp-controller="Home" asp-action="Index" class="aura-logo">
            <div class="logo-icon">A</div>
            AURA <span class="project-track-label">VNG - Track A: <strong>The Escalation Referee</strong></span>
        </a>
        
        <div class="header-actions">
            <!-- ZERO LOGIN TABS -->
            <div class="top-tabs">
                <button class="nav-link active" onclick="navigateToTab('applicant')" id="btn-tab-applicant">Cửa Sổ Nhân Viên</button>
                <button class="nav-link" onclick="navigateToTab('reviewer')" id="btn-tab-reviewer">Cửa Sổ Quản Lý</button>
                <button class="nav-link" onclick="navigateToTab('audit')" id="btn-tab-audit">Lịch Sử Của Hệ Thống</button>
            </div>
            
            
        </div>
    </header>

    <main role="main" style="padding-top: 32px;">
        @if (TempData["Success"] is string successMessage)
        {
            <div id="flashSuccessMessage" data-message="@successMessage" hidden></div>
        }
        @RenderBody()
    </main>

    <div class="toast-container-aura" id="toastContainer" aria-live="polite" aria-atomic="true"></div>
    <button type="button" id="backToTop" class="back-to-top" aria-label="Lên đầu trang" title="Lên đầu trang">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M18 15l-6-6-6 6" />
        </svg>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        function switchTab(tabId) {
            // Remove active classes
            document.querySelectorAll('.top-tabs .nav-link').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content-pane').forEach(pane => {
                pane.style.display = 'none';
            });
            
            // Add active class to clicked button if it's one of the main tabs
            const btn = document.getElementById('btn-tab-' + tabId);
            if (btn) btn.classList.add('active');
            
            // Show corresponding pane
            const targetPane = document.getElementById('pane-' + tabId);
            if(targetPane) {
                targetPane.style.display = 'block';
            }
        }

        function navigateToTab(tabId) {
            const url = new URL(window.location.href);
            if (tabId === 'applicant') url.searchParams.delete('tab');
            else url.searchParams.set('tab', tabId);
            window.location.assign(url.pathname + url.search);
        }

        function showToast(message, type) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'aura-toast ' + (type === 'danger' ? 'danger' : 'success');
            toast.setAttribute('role', type === 'danger' ? 'alert' : 'status');
            toast.textContent = message;
            container.appendChild(toast);
            window.setTimeout(() => toast.classList.add('visible'), 10);
            window.setTimeout(() => {
                toast.classList.remove('visible');
                window.setTimeout(() => toast.remove(), 250);
            }, 4000);
        }

        const flashSuccessMessage = document.getElementById('flashSuccessMessage');
        if (flashSuccessMessage?.dataset.message) {
            showToast(flashSuccessMessage.dataset.message, 'success');
        }

        const initialTab = new URLSearchParams(window.location.search).get('tab');
        if (initialTab === 'reviewer' || initialTab === 'audit') switchTab(initialTab);

        const backToTopButton = document.getElementById('backToTop');
        function updateBackToTopVisibility() {
            backToTopButton.classList.toggle('visible', window.scrollY > 360);
        }
        window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
        backToTopButton.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        updateBackToTopVisibility();
        
    </script>
</body>
</html>

