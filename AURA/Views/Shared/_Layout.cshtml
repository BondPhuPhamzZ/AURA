<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AURA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="nav-bar">
        <div class="logo-area">
            <div class="logo-icon">A</div>
            AURA <span style="font-weight:400; color:var(--colors-muted); font-size:14px; border-left:1px solid var(--colors-hairline); padding-left:12px; margin-left:12px;">Zero-Cloud Exposure</span>
        </div>
        
        <div>
            <a href="/" class="button-ghost-sm" style="margin-right: 8px; text-decoration: none;">Nộp Đơn</a>
            <a href="/Verify" class="button-ghost-sm" style="text-decoration: none;">Verify Harness</a>
        </div>
    </header>

    <div class="pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

