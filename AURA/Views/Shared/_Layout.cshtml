<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AURA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="aura-header">
        <a asp-controller="Home" asp-action="Index" class="aura-logo">
            <div class="logo-icon">A</div>
            AURA <span style="font-weight:400; color:var(--colors-ink-subtle); font-size:14px; border-left:1px solid var(--colors-border); padding-left:12px; margin-left:12px;">Gemini Vision + Deterministic Policy</span>
        </a>
        
        <div style="display: flex; gap: 24px; align-items: center;">
            <!-- ZERO LOGIN TABS -->
            <div class="top-tabs">
                <button class="nav-link active" onclick="switchTab('applicant')" id="btn-tab-applicant">Cửa Sổ Nhân Viên</button>
                <button class="nav-link" onclick="switchTab('reviewer')" id="btn-tab-reviewer">Cửa Sổ Quản Lý</button>
                <button class="nav-link" onclick="switchTab('audit')" id="btn-tab-audit">Lịch Sử Của Hệ Thống</button>
            </div>
            
            
        </div>
    </header>

    <main role="main" style="padding-top: 32px;">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        function switchTab(tabId) {
            // Remove active classes
            document.querySelectorAll('.top-tabs .nav-link').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content-pane').forEach(pane => {
                pane.style.display = 'none';
            });
            
            // Add active class to clicked button if it's one of the main tabs
            const btn = document.getElementById('btn-tab-' + tabId);
            if (btn) btn.classList.add('active');
            
            // Show corresponding pane
            const targetPane = document.getElementById('pane-' + tabId);
            if(targetPane) {
                targetPane.style.display = 'block';
            }
        }
        
    </script>
</body>
</html>

