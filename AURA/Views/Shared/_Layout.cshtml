<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AURA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="logo-area">
            <div class="logo-icon">A</div>
            AURA <span style="font-weight:400; color:var(--text-secondary); font-size:14px; border-left:1px solid var(--border-color); padding-left:12px; margin-left:12px;">Zero-Cloud Exposure</span>
        </div>
        
        <div class="tabs">
            <div class="tab active" id="tab-applicant" onclick="switchTab('applicant')">👨‍💻 Cổng Nộp Đơn (Nhân Viên)</div>
            <div class="tab" id="tab-reviewer" onclick="switchTab('reviewer')">👔 Cổng Thẩm Định (Sếp)</div>
        </div>
        <div style="width: 200px;"></div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            
            if (tab === 'applicant') {
                document.getElementById('applicant-view').style.display = 'block';
                document.getElementById('verify-view').style.display = 'none';
            } else {
                document.getElementById('applicant-view').style.display = 'none';
                document.getElementById('verify-view').style.display = 'none';
                alert('Màn hình "Sếp Duyệt Đơn" sẽ tải danh sách các ca chờ ESCALATE từ Controller.');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
