@{
    ViewData["Title"] = "Dashboard";
}
@using AURA.Options
@using Microsoft.Extensions.Options
@inject IOptions<ReceiptStorageOptions> ReceiptStorage
@{
    var initialTab = ViewData["InitialTab"] as string ?? "applicant";
    var applicantDisplay = initialTab == "applicant" ? "block" : "none";
    var reviewerDisplay = initialTab == "reviewer" ? "block" : "none";
    var auditDisplay = initialTab == "audit" ? "block" : "none";
}

<!-- Tab Applicant / Tester -->
<div class="tab-content-pane feature-card @(initialTab == "applicant" ? "active" : null)" id="pane-applicant" style="padding: 24px; display: @applicantDisplay;">
    
    <!-- Hướng dẫn & Verify Harness (Top Section) -->
    <div class="section-heading-row verify-heading-row">
        <div class="verify-copy">
            <h2 class="hero-title" style="font-size: 1.5rem; margin-bottom: 8px;">Verify Harness</h2>
            <p class="hero-sub" style="color: var(--colors-ink-subtle); margin: 0; font-size: 0.95rem;">
                Nhấn nút bên phải để AI tự động chạy kiểm thử trên bộ 5 hóa đơn chuẩn hóa. Bạn cũng có thể tải lên 1 hóa đơn thủ công ở khung bên dưới.
            </p>
        </div>
        <div class="verify-action">
            <button type="button" id="verifyHarnessButton" class="button-primary verify-primary-button" onclick="startVerifyHarness()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3l14 9-14 9V3z"/></svg>
                <span id="btnVerifyText">Chạy Verify Harness (90s)</span>
            </button>
            <form id="verifyFormDummy" asp-controller="Verify" asp-action="RunHarness" method="post" style="display: none;">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>

    <!-- Upload Thủ Công (Middle Section) -->
    <section class="workflow-section upload-section" aria-labelledby="single-upload-title">
        <form id="uploadForm" asp-controller="Applicant" asp-action="UploadReceipt" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <div class="upload-workspace">
                <div class="upload-input-column">
                    <h3 id="single-upload-title" class="workflow-subtitle">Tải lên hóa đơn lẻ</h3>
                    <div class="dropzone-area" id="dropzone" onclick="document.getElementById('receiptFile').click()">
                        <input type="file" id="receiptFile" name="receiptFile" accept=".jpg,.jpeg,.png" style="display: none;" onchange="handleFileSelect(this)">
                        <img id="receiptLocalPreview" class="receipt-local-preview" alt="Xem trước hóa đơn đã chọn" hidden />
                        <div class="dropzone-placeholder" id="dropzonePlaceholder">
                            <div class="dropzone-icon">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            </div>
                            <div class="dropzone-text" id="dropzoneText">Kéo thả ảnh hóa đơn vào đây</div>
                            <div class="dropzone-subtext">Hỗ trợ JPG, PNG (Tối đa @ReceiptStorage.Value.MaxFileSizeMb MB)</div>
                        </div>
                    </div>
                    <div class="amount-action-row">
                        <div class="amount-field">
                            <label for="claimedAmountDisplay" class="form-label fw-semibold">Số tiền nhân viên đề nghị hoàn ứng (VND)</label>
                            <input id="claimedAmountDisplay" type="text" inputmode="numeric" autocomplete="off" required
                                   class="form-control amount-input-aura" placeholder="Ví dụ: 150.000" aria-describedby="claimedAmountHelp" />
                            <input id="claimedAmount" name="claimedAmount" type="hidden" />
                            <div id="claimedAmountHelp" class="form-text">
                                Nhập số tiền thực tế nhân viên yêu cầu. Hệ thống tự thêm dấu chấm phân cách hàng nghìn.
                            </div>
                        </div>
                        <div class="amount-submit-wrap">
                            <button type="submit" id="submitBtn" class="button-primary">
                                <span id="btnText">AI tự động kiểm</span>
                            </button>
                        </div>
                    </div>
                    <div class="submitter-context-grid" aria-label="Ngữ cảnh người gửi">
                        <div class="submitter-field">
                            <label for="submitterCode" class="form-label fw-semibold">Mã nhân viên</label>
                            <input id="submitterCode" name="submitterCode" class="form-control submitter-input" maxlength="100" value="EMP-001" required />
                        </div>
                        <div class="submitter-field">
                            <label for="submitterDisplayName" class="form-label fw-semibold">Người gửi</label>
                            <input id="submitterDisplayName" name="submitterDisplayName" class="form-control submitter-input" maxlength="200" value="Gia Phú" required />
                        </div>
                        <div class="submitter-field">
                            <label for="submitterDepartment" class="form-label fw-semibold">Bộ phận</label>
                            <input id="submitterDepartment" name="submitterDepartment" class="form-control submitter-input" maxlength="200" value="Vận hành" required />
                        </div>
                    </div>
                </div>

                <div class="extracted-facts-column">
                    <h3 id="extracted-facts-title" class="workflow-subtitle extracted-facts-title">Nội dung AI — hóa đơn lẻ</h3>
                    <section class="extracted-facts-panel" aria-labelledby="extracted-facts-title" aria-live="polite">
                        <div class="extracted-facts-toolbar">
                            <span id="extractedFactsConfidence" class="badge facts-confidence-badge bg-secondary">Chưa quét</span>
                        </div>
                        <div id="extractedFactsBody" class="extracted-facts-empty">
                            Kết quả trích xuất sẽ xuất hiện tại đây sau khi AI xử lý ảnh. Giá trị không đọc chắc chắn được hiển thị là “Không đọc được”, không tự suy đoán.
                        </div>
                    </section>
                </div>
            </div>
        </form>
    </section>

    <!-- Bảng Kết Quả Hợp Nhất (Bottom Section) -->
    <section id="unifiedResultsSection" class="workflow-section results-section">
        <div class="section-heading-row compact">
            <div>
                <h3 style="font-size: 1.25rem; margin: 0;">Bảng kết quả thẩm định</h3>
                <div id="analysisSummary" class="analysis-summary" role="status" aria-live="polite">
                    <span class="summary-placeholder">Chưa có lượt phân tích mới.</span>
                </div>
            </div>
            <div class="results-heading-actions">
                <button type="button" class="button-primary button-compact" onclick="forwardAllToManager(this)">Chuyển tiếp tất cả</button>
                <button type="button" class="button-ghost-sm history-button" onclick="navigateToTab('audit')">Xem lịch sử hành vi</button>
            </div>
        </div>

        <div id="analysisProgressNotice" class="analysis-progress-notice" role="status"
             aria-live="polite" aria-busy="false" hidden>
            <span class="analysis-progress-spinner" aria-hidden="true"></span>
            <div>
                <strong id="analysisProgressTitle">AI đang xử lý hồ sơ</strong>
                <span id="analysisProgressDetail">Bảng sẽ tự cập nhật, không cần tải lại trang.</span>
            </div>
            <span id="analysisProgressElapsed" class="analysis-progress-elapsed"></span>
        </div>
        
        <p class="table-caption">
            Ca tự động duyệt được ghi thẳng vào lịch sử. Ca cần xử lý được giữ tại đây cho tới khi nhân viên chuyển tiếp. <strong>Kỳ vọng/Đối chiếu</strong> chỉ dùng trong lượt Verify có nhãn sẵn.
        </p>
        <div class="table-responsive-aura table-scroll-area">
            <table class="table-aura results-table responsive-cards">
                <thead>
                    <tr>
                        <th>Mã hồ sơ</th>
                        <th>Ảnh</th>
                        <th title="Kết quả chuẩn chỉ tồn tại ở bộ Verify">Kỳ vọng kiểm thử</th>
                        <th>Kết quả hệ thống</th>
                        <th title="So sánh Actual với Expected trong Verify">Đối chiếu</th>
                        <th>Lý do và câu hỏi</th>
                        <th>Độ trễ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="resultsBody">
                    @await Component.InvokeAsync("EmployeeEscalationQueue")
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- Tab Reviewer -->
<div class="tab-content-pane feature-card @(initialTab == "reviewer" ? "active" : null)" id="pane-reviewer" style="display: @reviewerDisplay;">
    <div id="reviewerQueueHost">@await Component.InvokeAsync("EscalationQueue")</div>
</div>

<!-- Tab Audit Log -->
<div class="tab-content-pane feature-card @(initialTab == "audit" ? "active" : null)" id="pane-audit" style="display: @auditDisplay;">
    <div id="auditTrailHost">@await Component.InvokeAsync("AuditLogQueue")</div>
</div>

<style>
    /* CSS for skeleton loading animation */
    .skeleton-row td {
        position: relative;
        overflow: hidden;
    }
    .skeleton-row td::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
        animation: loading 1.5s infinite;
    }
    @@keyframes loading {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    .skeleton-text {
        height: 16px;
        background-color: var(--colors-surface-alt);
        border-radius: 6px;
        width: 80%;
    }
    .analysis-progress-notice {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 14px 0 10px;
        padding: 12px 14px;
        border: 1px solid var(--colors-border);
        border-radius: 6px;
        background: var(--colors-surface-soft);
        color: var(--colors-ink);
    }
    .analysis-progress-notice[hidden] { display: none; }
    .analysis-progress-notice > div { display: grid; gap: 2px; min-width: 0; }
    .analysis-progress-notice strong { font-size: 0.9rem; }
    .analysis-progress-notice span:not(.analysis-progress-spinner) { color: var(--colors-ink-subtle); font-size: 0.82rem; }
    .analysis-progress-spinner {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        border: 2px solid rgba(255,255,255,.22);
        border-top-color: var(--colors-primary);
        border-radius: 50%;
        animation: analysis-spin .8s linear infinite;
    }
    .analysis-progress-elapsed { margin-left: auto; white-space: nowrap; }
    .analysis-progress-notice.is-complete .analysis-progress-spinner,
    .analysis-progress-notice.is-error .analysis-progress-spinner { animation: none; border-radius: 6px; }
    .analysis-progress-notice.is-complete .analysis-progress-spinner { border-color: var(--bs-success); background: var(--bs-success); }
    .analysis-progress-notice.is-error .analysis-progress-spinner { border-color: var(--bs-danger); background: var(--bs-danger); }
    @@keyframes analysis-spin { to { transform: rotate(360deg); } }
    @@media (max-width: 640px) { .analysis-progress-elapsed { display: none; } }
</style>

<script>
    // Drag & Drop logic for upload
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('receiptFile');
    const dropzoneText = document.getElementById('dropzoneText');
    const dropzoneSubtext = document.querySelector('.dropzone-subtext');
    const receiptLocalPreview = document.getElementById('receiptLocalPreview');
    const dropzonePlaceholder = document.getElementById('dropzonePlaceholder');
    const uploadForm = document.getElementById('uploadForm');
    const amountDisplayInput = document.getElementById('claimedAmountDisplay');
    const amountRawInput = document.getElementById('claimedAmount');
    const maxUploadBytes = @((long)ReceiptStorage.Value.MaxFileSizeMb * 1024L * 1024L);
    const maxUploadMegabytes = @ReceiptStorage.Value.MaxFileSizeMb;
    const resultsBody = document.getElementById('resultsBody');
    const emptyResultsRow = '<tr><td colspan="8" class="text-center empty-state">Không có hồ sơ nào đang chờ chuyển tiếp. Ca tự động duyệt đã được ghi thẳng vào lịch sử.</td></tr>';
    let currentAnalysisItems = [];
    let processingPlaceholderRows = 0;
    let selectedFactsCaseId = null;
    let persistedEscalationRows = Array.from(resultsBody.querySelectorAll('tr[data-case-id]'))
        .map(row => ({ caseId: row.dataset.caseId, html: row.outerHTML }));
    let queueRefreshInFlight = false;
    let analysisProgressStartedAt = null;
    let analysisProgressTimer = null;
    let localPreviewUrl = null;

    function syncClaimedAmount() {
        const digits = amountDisplayInput.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
        amountRawInput.value = digits;
        amountDisplayInput.value = digits ? new Intl.NumberFormat('vi-VN').format(Number(digits)) : '';
        return digits;
    }

    amountDisplayInput.addEventListener('input', syncClaimedAmount);

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
        dropzone.classList.add('dragover');
    }

    function unhighlight(e) {
        dropzone.classList.remove('dragover');
    }

    dropzone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0 && validateSelectedFile(files[0])) {
            fileInput.files = files;
            updateDropzoneUI(files[0]);
        }
    }

    function handleFileSelect(input) {
        if (input.files && input.files.length > 0) {
            if (validateSelectedFile(input.files[0])) {
                updateDropzoneUI(input.files[0]);
            } else {
                input.value = '';
            }
        }
    }

    function validateSelectedFile(file) {
        if (!file) return false;
        const extension = file.name.split('.').pop()?.toLowerCase();
        if (!['jpg', 'jpeg', 'png'].includes(extension)) {
            showToast('Chỉ chấp nhận ảnh JPG hoặc PNG.', 'danger');
            return false;
        }
        if (file.size > maxUploadBytes) {
            showToast(`Ảnh vượt quá giới hạn ${maxUploadMegabytes} MB. Vui lòng nén ảnh hoặc chọn ảnh nhỏ hơn.`, 'danger');
            return false;
        }
        return true;
    }

    function updateDropzoneUI(file) {
        if (localPreviewUrl) URL.revokeObjectURL(localPreviewUrl);
        localPreviewUrl = URL.createObjectURL(file);
        receiptLocalPreview.src = localPreviewUrl;
        receiptLocalPreview.hidden = false;
        dropzonePlaceholder.classList.add('with-preview');
        dropzone.classList.add('has-preview');
        dropzoneText.textContent = file.name;
        dropzoneSubtext.innerText = 'Click hoặc kéo thả ảnh khác để thay đổi';
        renderExtractedFacts(null);
    }

    uploadForm.addEventListener('submit', event => {
        event.preventDefault();
        submitUpload();
    });

    function displayFact(value) {
        return value == null || String(value).trim() === '' ? 'Không đọc được' : String(value);
    }

    function formatFactMoney(value) {
        return value == null ? 'Không đọc được' : new Intl.NumberFormat('vi-VN').format(Number(value)) + ' VND';
    }

    function setExtractedFactsContext(contextLabel) {
        const title = document.getElementById('extracted-facts-title');
        title.textContent = contextLabel ? `Nội dung AI — ${contextLabel}` : 'Nội dung AI — hóa đơn lẻ';
    }

    function renderExtractedFacts(facts, contextLabel = '') {
        const body = document.getElementById('extractedFactsBody');
        const confidence = document.getElementById('extractedFactsConfidence');
        setExtractedFactsContext(contextLabel);
        if (!facts) {
            confidence.className = 'badge facts-confidence-badge bg-secondary';
            confidence.textContent = 'Chưa quét';
            body.className = 'extracted-facts-empty';
            body.textContent = 'Kết quả trích xuất sẽ xuất hiện tại đây sau khi AI xử lý ảnh. Giá trị không đọc chắc chắn được hiển thị là “Không đọc được”, không tự suy đoán.';
            return;
        }

        const confidencePercent = Math.round(Number(facts.confidence || 0) * 100);
        confidence.className = 'badge facts-confidence-badge ' + (confidencePercent >= 70 ? 'bg-success' : 'bg-warning text-dark');
        confidence.textContent = `Tin cậy ${confidencePercent}%`;
        const identifierRows = [
            ['Số hóa đơn', facts.invoiceNumber],
            ['Số biên nhận / Bill No', facts.receiptNumber],
            ['Mã giao dịch', facts.transactionReference],
            ['Mã đơn hàng', facts.orderId],
            ['Mã chuyến / đặt chỗ', facts.bookingId],
            ['Mã vận chuyển', facts.shippingTrackingCode]
        ].filter(entry => entry[1] != null && String(entry[1]).trim() !== '');
        const identifierHtml = identifierRows.length
            ? identifierRows.map(entry => '<div><dt>' + escapeHtml(entry[0]) + '</dt><dd>' + escapeHtml(displayFact(entry[1])) + '</dd></div>').join('')
            : '<div><dt>Định danh giao dịch</dt><dd>Không đọc được</dd></div>';
        const normalizedDocumentType = String(facts.documentType || '').trim().toUpperCase();
        const isDigitalEvidence = normalizedDocumentType === 'ECOMMERCE' ||
            normalizedDocumentType === 'RIDE_HAILING' ||
            normalizedDocumentType.includes('DIGITAL') ||
            normalizedDocumentType.includes('ELECTRONIC') ||
            normalizedDocumentType.includes('E-INVOICE');
        const evidenceDate = isDigitalEvidence
            ? (facts.transactionDate || facts.invoiceDate)
            : (facts.invoiceDate || facts.transactionDate);
        const evidenceDateLabel = isDigitalEvidence
            ? 'Ngày giao dịch / thanh toán'
            : 'Ngày chứng từ / giao dịch';
        const items = Array.isArray(facts.lineItems) && facts.lineItems.length
            ? '<ul class="extracted-line-items">' + facts.lineItems.map(item =>
                '<li><span>' + escapeHtml(displayFact(item.description)) + '</span><strong>' + escapeHtml(formatFactMoney(item.amount)) + '</strong></li>').join('') + '</ul>'
            : '<span class="fact-value missing">Không đọc được dòng hàng</span>';
        const warnings = [...(facts.missingFields || []), ...(facts.warnings || []),
            ...(facts.suspiciousSignals || []), ...(facts.validationIssues || [])];

        body.className = 'extracted-facts-content';
        body.innerHTML =
            '<dl class="extracted-facts-grid">' +
                '<div><dt>Loại chứng từ</dt><dd>' + escapeHtml(displayFact(facts.documentType)) + '</dd></div>' +
                '<div><dt>Đơn vị bán</dt><dd>' + escapeHtml(displayFact(facts.merchantName)) + '</dd></div>' +
                identifierHtml +
                '<div><dt>Mã số thuế</dt><dd>' + escapeHtml(displayFact(facts.taxId)) + '</dd></div>' +
                '<div><dt>' + escapeHtml(evidenceDateLabel) + '</dt><dd>' + escapeHtml(displayFact(evidenceDate)) + '</dd></div>' +
                (facts.subtotal != null ? '<div><dt>Tạm tính</dt><dd>' + escapeHtml(formatFactMoney(facts.subtotal)) + '</dd></div>' : '') +
                (facts.discountAmount != null && Number(facts.discountAmount) > 0 ? '<div><dt>Giảm giá / chiết khấu</dt><dd>-' + escapeHtml(formatFactMoney(Number(facts.discountAmount))) + '</dd></div>' : '') +
                (facts.tax != null && Number(facts.tax) !== 0 ? '<div><dt>Thuế</dt><dd>' + escapeHtml(formatFactMoney(facts.tax)) + '</dd></div>' : '') +
                '<div><dt>Tổng thanh toán</dt><dd>' + escapeHtml(formatFactMoney(facts.totalAmount)) + '</dd></div>' +
                '<div><dt>Tiền tệ</dt><dd>' + escapeHtml(displayFact(facts.currency)) + '</dd></div>' +
                '<div><dt>Trạng thái</dt><dd>' + escapeHtml(displayFact(facts.documentStatus || facts.orderStatus)) + '</dd></div>' +
                (facts.completionDate ? '<div><dt>Ngày hoàn tất (tham khảo)</dt><dd>' + escapeHtml(displayFact(facts.completionDate)) + '</dd></div>' : '') +
            '</dl>' +
            '<div class="extracted-items-block"><strong>Dòng hàng AI nhận diện</strong>' + items + '</div>' +
            (warnings.length ? '<div class="extracted-warning"><strong>Cần lưu ý:</strong> ' + escapeHtml(warnings.join('; ')) + '</div>' : '');
    }

    function renderExtractedFactsLoading(message, contextLabel = '') {
        const body = document.getElementById('extractedFactsBody');
        const confidence = document.getElementById('extractedFactsConfidence');
        setExtractedFactsContext(contextLabel);
        confidence.className = 'badge facts-confidence-badge bg-primary';
        confidence.textContent = 'Đang xử lý';
        body.className = 'extracted-facts-loading';
        body.innerHTML =
            '<div class="facts-loading-message"><span class="facts-loading-spinner" aria-hidden="true"></span>' + escapeHtml(message) + '</div>' +
            '<div class="facts-loading-grid" aria-hidden="true">' +
                '<span></span><span></span><span></span><span></span><span></span><span></span>' +
            '</div>';
    }

    function renderExtractedFactsUnavailable(message, contextLabel = '') {
        const body = document.getElementById('extractedFactsBody');
        const confidence = document.getElementById('extractedFactsConfidence');
        setExtractedFactsContext(contextLabel);
        confidence.className = 'badge facts-confidence-badge bg-warning text-dark';
        confidence.textContent = 'Chưa có dữ liệu';
        body.className = 'extracted-facts-empty extracted-facts-unavailable';
        body.textContent = message;
    }

    function getSkeletonRow() {
        return '<tr class="skeleton-row">' +
            '<td><div class="skeleton-text" style="width: 40px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 100px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 50px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 100%;"></div><div class="skeleton-text" style="width: 60%; margin-top: 4px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 60px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '</tr>';
    }

    function renderResultRow(item) {
        const isProcessing = item.processingState === 'PENDING' || item.processingState === 'PROCESSING';
        const passBadge = item.pass == null
            ? '<span class="badge bg-secondary">KHÔNG ÁP DỤNG</span>'
            : item.pass ? '<span class="badge bg-success">PASS</span>' : '<span class="badge bg-danger">FAIL</span>';
        let expectedBadge = item.expected
            ? '<span class="badge bg-secondary">' + escapeHtml(item.expected) + '</span>'
            : '<span class="text-muted">Không áp dụng</span>';
        if(item.expected === 'AUTO_APPROVE') expectedBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.expected && item.expected.startsWith('ESCALATE')) expectedBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.expected) + '</span>';
        
        let actualBadge = isProcessing
            ? '<span class="badge bg-info text-dark">ĐANG XỬ LÝ</span>'
            : '<span class="badge bg-secondary">' + escapeHtml(item.actual || 'CHƯA CÓ') + '</span>';
        if(item.actual === 'AUTO_APPROVE') actualBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.actual && item.actual.startsWith('ESCALATE_')) actualBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.actual) + '</span>';
        if(item.actual === 'ESCALATE_SYSTEM_ERROR') actualBadge = '<span class="badge bg-danger">SYSTEM_ERROR</span>';
        
        const workflowAction = isProcessing
            ? '<span class="text-muted">Đang chờ</span>'
            : item.canForward
            ? '<button type="button" class="button-primary button-compact" onclick="forwardToManager(\'' + escapeJsString(item.caseId) + '\', this)">Chuyển tiếp</button>'
            : '<span class="text-muted">Không cần</span>';
        const factsAction = item.facts
            ? '<button type="button" class="button-ghost-sm facts-view-button" aria-pressed="' +
              (selectedFactsCaseId === item.caseId ? 'true' : 'false') + '" onclick="showAnalysisFacts(\'' + escapeJsString(item.caseId) + '\')">Xem dữ kiện</button>'
            : '';
        const receipt = item.receiptUrl
            ? '<a class="receipt-preview-link" href="' + escapeHtml(item.receiptUrl) + '" target="_blank" rel="noopener">' +
              '<img class="receipt-thumbnail" src="' + escapeHtml(item.receiptUrl) + '" alt="Ảnh chứng từ ' + escapeHtml(item.image) + '" loading="lazy" />' +
              '<span>' + escapeHtml(item.image) + '</span></a>'
            : escapeHtml(item.image);
        const handoffText = item.canForward ? (item.handoffPrompt || '') : (item.question || '');

        const rowClass = selectedFactsCaseId === item.caseId ? ' class="facts-selected"' : '';
        return '<tr' + rowClass + ' data-case-id="' + escapeHtml(item.caseId || '') + '" data-can-forward="' +
            (item.canForward ? 'true' : 'false') + '" data-row-source="current-analysis">' +
            '<td data-label="Mã hồ sơ" class="cell-code">' + escapeHtml(item.caseId ? item.caseId.substring(0,8) : '') + '</td>' +
            '<td data-label="Ảnh">' + receipt + '</td>' +
            '<td data-label="Kỳ vọng">' + expectedBadge + '</td>' +
            '<td data-label="Kết quả">' + actualBadge + '</td>' +
            '<td data-label="Đối chiếu">' + passBadge + '</td>' +
            '<td data-label="Lý do và câu hỏi" class="cell-reason"><strong>' + escapeHtml(item.reason) + '</strong><small>' + escapeHtml(handoffText) + '</small></td>' +
            '<td data-label="Độ trễ" class="cell-number">' + (item.latencyMs == null ? '—' : escapeHtml(item.latencyMs) + ' ms') + '</td>' +
            '<td data-label="Thao tác" class="cell-actions"><div class="result-row-actions">' + factsAction + workflowAction + '</div></td>' +
        '</tr>';
    }

    function getAnalysisFactsLabel(item) {
        const testCase = item?.testCaseId ? String(item.testCaseId) : '';
        const image = item?.image ? String(item.image) : '';
        return [testCase, image].filter(Boolean).join(' · ') || 'hồ sơ đã chọn';
    }

    function showAnalysisFacts(caseId, shouldScroll = true) {
        const item = currentAnalysisItems.find(candidate => candidate?.caseId === caseId);
        if (!item?.facts) {
            renderExtractedFactsUnavailable('Ca này chưa có dữ kiện trích xuất để hiển thị.', getAnalysisFactsLabel(item));
            return;
        }

        selectedFactsCaseId = caseId;
        renderExtractedFacts(item.facts, getAnalysisFactsLabel(item));
        document.querySelectorAll('#resultsBody tr[data-row-source="current-analysis"]').forEach(row => {
            const selected = row.dataset.caseId === caseId;
            row.classList.toggle('facts-selected', selected);
            row.querySelector('.facts-view-button')?.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });

        if (shouldScroll) {
            document.querySelector('.extracted-facts-column')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value == null ? '' : String(value);
        return element.innerHTML;
    }

    function escapeJsString(value) {
        return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }

    function renderResultsTable() {
        const currentIds = new Set(currentAnalysisItems
            .map(item => item?.caseId)
            .filter(Boolean));
        const currentHtml = currentAnalysisItems.map(renderResultRow).join('');
        const placeholderHtml = Array.from({ length: processingPlaceholderRows }, getSkeletonRow).join('');
        const persistedHtml = persistedEscalationRows
            .filter(row => row.caseId && !currentIds.has(row.caseId))
            .map(row => row.html)
            .join('');

        resultsBody.innerHTML = currentHtml + placeholderHtml + persistedHtml || emptyResultsRow;
        updatePendingEscalationSummary();
    }

    function setCurrentAnalysisItems(items) {
        currentAnalysisItems = (Array.isArray(items) ? items : [items]).filter(Boolean);
        if (!currentAnalysisItems.some(item => item?.caseId === selectedFactsCaseId && item?.facts)) {
            selectedFactsCaseId = null;
        }
        processingPlaceholderRows = 0;
        renderResultsTable();
    }

    async function refreshEmployeeEscalationQueue() {
        if (queueRefreshInFlight) return;
        queueRefreshInFlight = true;
        try {
            const response = await fetch('@Url.Action("EmployeeEscalations", "Home")', { cache: 'no-store' });
            if (!response.ok) return;
            const container = document.createElement('tbody');
            container.innerHTML = await response.text();
            if (container.querySelector('td.text-danger')) return;
            persistedEscalationRows = Array.from(container.querySelectorAll('tr[data-case-id]'))
                .map(row => ({ caseId: row.dataset.caseId, html: row.outerHTML }));
            renderResultsTable();
        } catch {
            // A transient queue-refresh failure must not erase the last known rows.
        } finally {
            queueRefreshInFlight = false;
        }
    }

    function beginAnalysisProgress(title, detail) {
        const notice = document.getElementById('analysisProgressNotice');
        notice.hidden = false;
        notice.classList.remove('is-complete', 'is-error');
        notice.setAttribute('aria-busy', 'true');
        document.getElementById('analysisProgressTitle').textContent = title;
        document.getElementById('analysisProgressDetail').textContent = detail;
        analysisProgressStartedAt = Date.now();
        clearInterval(analysisProgressTimer);
        const updateElapsed = () => {
            const seconds = Math.max(0, Math.floor((Date.now() - analysisProgressStartedAt) / 1000));
            document.getElementById('analysisProgressElapsed').textContent = `Đã chờ ${seconds}s`;
        };
        updateElapsed();
        analysisProgressTimer = setInterval(updateElapsed, 1000);
    }

    function finishAnalysisProgress(title, detail, isError = false) {
        clearInterval(analysisProgressTimer);
        analysisProgressTimer = null;
        const notice = document.getElementById('analysisProgressNotice');
        notice.hidden = false;
        notice.classList.toggle('is-complete', !isError);
        notice.classList.toggle('is-error', isError);
        notice.setAttribute('aria-busy', 'false');
        document.getElementById('analysisProgressTitle').textContent = title;
        document.getElementById('analysisProgressDetail').textContent = detail;
        document.getElementById('analysisProgressElapsed').textContent = '';
    }

    function updateAnalysisSummary(items) {
        const rows = Array.isArray(items) ? items : [items];
        const approved = rows.filter(item => item?.actual === 'AUTO_APPROVE').length;
        const escalated = rows.filter(item => item?.actual?.startsWith('ESCALATE_')).length;
        updatePendingEscalationSummary();
        showToast(`Đã phân tích ${rows.length} hồ sơ: ${approved} tự động duyệt, ${escalated} cần chuyển tiếp.`,
            escalated > 0 ? 'warning' : 'success');
    }

    function updatePendingEscalationSummary() {
        const approvedCount = currentAnalysisItems.filter(item => item?.actual === 'AUTO_APPROVE').length;
        const pendingCount = document.querySelectorAll('#resultsBody tr[data-can-forward="true"]').length;
        const summary = document.getElementById('analysisSummary');
        if (approvedCount === 0 && pendingCount === 0 && currentAnalysisItems.length === 0 && processingPlaceholderRows === 0) {
            summary.innerHTML = '<span class="summary-placeholder">Chưa có lượt phân tích mới.</span>';
            return;
        }
        summary.innerHTML = '<span class="summary-approved">' + approvedCount + ' tự động duyệt trong lượt hiện tại</span>' +
            '<span class="summary-escalated">' + pendingCount + ' đang chờ chuyển tiếp</span>';
    }

    async function readJsonResponse(response, context) {
        const rawBody = await response.text();
        let payload = null;

        if (rawBody.trim()) {
            try {
                payload = JSON.parse(rawBody);
            } catch {
                if (!response.ok) {
                    throw new Error(`${context} thất bại (HTTP ${response.status}); máy chủ trả về phản hồi không đúng định dạng.`);
                }
                throw new Error(`${context} nhận được phản hồi JSON không hợp lệ từ máy chủ.`);
            }
        }

        if (!response.ok) {
            if (response.status === 413) {
                throw new Error(`Ảnh vượt quá giới hạn ${maxUploadMegabytes} MB.`);
            }
            throw new Error(payload?.error || `${context} thất bại (HTTP ${response.status}).`);
        }

        if (payload === null) {
            throw new Error(`${context} không nhận được dữ liệu phản hồi từ máy chủ.`);
        }

        return payload;
    }

    async function forwardToManager(caseId, button) {
        button.disabled = true;
        const originalText = button.innerText;
        button.innerText = 'Đang chuyển...';
        const formData = new FormData();
        formData.append('id', caseId);
        formData.append('__RequestVerificationToken', document.querySelector('#uploadForm input[name="__RequestVerificationToken"]').value);

        try {
            const response = await fetch('@Url.Action("ForwardToManager", "Applicant")', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            const data = await readJsonResponse(response, 'Chuyển tiếp hồ sơ');
            showToast(data.message, 'success');
            window.location.assign(data.redirectUrl || '@Url.Action("Index", "Home", new { tab = "reviewer" })');
        } catch (error) {
            showToast('Không thể chuyển tiếp: ' + error.message, 'danger');
            button.disabled = false;
            button.innerText = originalText;
        }
    }

    async function forwardAllToManager(button) {
        if (!confirm('Chuyển toàn bộ hồ sơ đang chờ đến quản lý?')) return;
        button.disabled = true;
        const originalText = button.innerText;
        button.innerText = 'Đang chuyển...';
        const formData = new FormData();
        formData.append('__RequestVerificationToken', document.querySelector('#uploadForm input[name="__RequestVerificationToken"]').value);
        try {
            const response = await fetch('@Url.Action("ForwardAllToManager", "Applicant")', {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: formData
            });
            const data = await readJsonResponse(response, 'Chuyển tiếp tất cả');
            showToast(data.message, 'success');
            window.location.assign(data.redirectUrl || '@Url.Action("Index", "Home", new { tab = "reviewer" })');
        } catch (error) {
            showToast('Không thể chuyển tiếp: ' + error.message, 'danger');
        } finally {
            button.disabled = false;
            button.innerText = originalText;
        }
    }

    function scrollToResults() {
        document.getElementById('unifiedResultsSection').scrollIntoView({ behavior: 'smooth' });
    }

    // AJAX Upload Single File
    async function submitUpload() {
        if (!fileInput.files || fileInput.files.length === 0) {
            showToast('Vui lòng tải lên ảnh hóa đơn.', 'danger');
            return;
        }
        if (!validateSelectedFile(fileInput.files[0])) return;
        const rawAmount = syncClaimedAmount();
        if (!rawAmount || Number(rawAmount) <= 0) {
            showToast('Vui lòng nhập số tiền đề nghị hoàn ứng hợp lệ.', 'danger');
            amountDisplayInput.focus();
            return;
        }

        const btn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = 'Đang xử lý...';
        renderExtractedFactsLoading('AI đang đọc và đối chiếu nội dung hóa đơn…');
        beginAnalysisProgress('AI đang tiếp nhận hóa đơn',
            'Ảnh sẽ được lưu trước, sau đó xử lý bằng hàng đợi bền vững. Bảng tự cập nhật, không cần tải lại trang.');

        currentAnalysisItems = [];
        processingPlaceholderRows = 1;
        renderResultsTable();

        const form = document.getElementById('uploadForm');
        const formData = new FormData(form);
        formData.set('claimedAmount', rawAmount);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });

            const data = await readJsonResponse(response, 'Tải lên hóa đơn');
            setCurrentAnalysisItems(data);
            sessionStorage.setItem('aura.pendingReceipt', JSON.stringify({ caseId: data.caseId, statusUrl: data.statusUrl }));
            btn.disabled = false;
            btnText.innerText = originalText;
            showToast('Đã ghi nhận hồ sơ. AI đang xử lý nền; bạn có thể tiếp tục thao tác.', 'success');
            const completed = await pollReceiptStatus(data.statusUrl);
            setCurrentAnalysisItems(completed);
            sessionStorage.removeItem('aura.pendingReceipt');
            if (completed.facts) showAnalysisFacts(completed.caseId, false);
            else renderExtractedFactsUnavailable('AI chưa trả về dữ liệu trích xuất; hồ sơ đã được chuyển sang kiểm tra thủ công.', completed.image);
            if (completed.duplicateDetected && !completed.duplicatePolicyEnabled) {
                showToast('Ảnh này đã từng được dùng; hệ thống vẫn xử lý vì đang bật chế độ kiểm thử.', 'warning');
            }
            updateAnalysisSummary(completed);
            finishAnalysisProgress('AI đã hoàn tất thẩm định',
                completed.canForward
                    ? 'Hồ sơ cần nhân viên chuyển tiếp để quản lý xem xét.'
                    : 'Kết quả đã được lưu vào lịch sử hành vi.');
            await refreshEmployeeEscalationQueue();
        } catch(e) {
            processingPlaceholderRows = 0;
            renderResultsTable();
            renderExtractedFactsUnavailable('Không nhận được nội dung từ AI: ' + e.message);
            finishAnalysisProgress('Không thể hoàn tất thẩm định', e.message, true);
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    async function pollReceiptStatus(statusUrl) {
        if (!statusUrl) throw new Error('Máy chủ không trả về địa chỉ theo dõi hồ sơ.');
        for (let attempt = 0; attempt < 900; attempt++) {
            const response = await fetch(statusUrl, { cache: 'no-store' });
            const item = await readJsonResponse(response, 'Theo dõi trạng thái AI');
            setCurrentAnalysisItems(item);
            if (item.processingState === 'COMPLETED' || item.processingState === 'FAILED') return item;
            await new Promise(resolve => setTimeout(resolve, 1000));
        }
        throw new Error('Hồ sơ vẫn đang xử lý sau 15 phút. Có thể tải lại trang để tiếp tục theo dõi.');
    }

    async function resumePendingReceipt() {
        const raw = sessionStorage.getItem('aura.pendingReceipt');
        if (!raw) return;
        try {
            const pending = JSON.parse(raw);
            beginAnalysisProgress('Đang khôi phục hồ sơ chưa hoàn tất',
                'Hàng đợi vẫn chạy trong nền; bảng sẽ tự cập nhật khi có kết quả.');
            const completed = await pollReceiptStatus(pending.statusUrl);
            sessionStorage.removeItem('aura.pendingReceipt');
            setCurrentAnalysisItems(completed);
            if (completed.facts) showAnalysisFacts(completed.caseId, false);
            updateAnalysisSummary(completed);
            finishAnalysisProgress('Đã khôi phục kết quả thẩm định',
                completed.canForward ? 'Hồ sơ đang chờ chuyển tiếp.' : 'Kết quả đã được lưu vào lịch sử hành vi.');
            await refreshEmployeeEscalationQueue();
        } catch (error) {
            showToast('Không thể khôi phục trạng thái xử lý: ' + error.message, 'warning');
            finishAnalysisProgress('Không thể khôi phục trạng thái', error.message, true);
        }
    }
    
    // Verify Harness logic (AJAX)
    async function startVerifyHarness() {
        const btn = document.getElementById('verifyHarnessButton');
        const btnText = document.getElementById('btnVerifyText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = 'Đang chạy 5 hóa đơn...';
        renderExtractedFactsLoading('AI đang lần lượt xử lý 5 ca Verify Harness…', 'Verify Harness');
        beginAnalysisProgress('Verify Harness đang chạy 5 ca',
            'Các ca được xử lý tuần tự để hạn chế rate limit. Bảng sẽ cập nhật sau khi cả batch hoàn tất.');
        currentAnalysisItems = [];
        processingPlaceholderRows = 5;
        renderResultsTable();
        
        const dummyForm = document.getElementById('verifyFormDummy');
        const formData = new FormData(dummyForm);
        
        try {
            const response = await fetch(dummyForm.action, {
                method: 'POST',
                body: formData
            });

            const data = await readJsonResponse(response, 'Verify Harness');
            
            if (data.error) {
                processingPlaceholderRows = 0;
                renderResultsTable();
                finishAnalysisProgress('Verify Harness không hoàn tất', data.error, true);
                return;
            }

            setCurrentAnalysisItems(data);
            const firstExtractedResult = data.find(item => item?.facts);
            if (firstExtractedResult) {
                showAnalysisFacts(firstExtractedResult.caseId, false);
            } else {
                renderExtractedFactsUnavailable('Verify Harness đã hoàn tất nhưng AI không trả về dữ liệu trích xuất cho bất kỳ ca nào. Hãy kiểm tra thông báo lỗi, quota hoặc cấu hình model.', 'Verify Harness');
                showToast('Không có nội dung AI nào được trả về trong lượt Verify này.', 'warning');
            }
            updateAnalysisSummary(data);
            finishAnalysisProgress('Verify Harness đã hoàn tất',
                'Chọn “Xem dữ kiện” tại từng dòng để đối chiếu nội dung AI của cả 5 ca; các ca escalation vẫn ở bảng cho tới khi chuyển tiếp.');
            await refreshEmployeeEscalationQueue();
            scrollToResults();
        } catch(e) {
            processingPlaceholderRows = 0;
            renderResultsTable();
            renderExtractedFactsUnavailable('Verify Harness không nhận được nội dung từ AI: ' + e.message, 'Verify Harness');
            finishAnalysisProgress('Verify Harness không hoàn tất', e.message, true);
            scrollToResults();
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    document.addEventListener('submit', async event => {
        const form = event.target.closest('.js-workflow-form');
        if (!form) return;
        event.preventDefault();
        const submitButton = event.submitter || form.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form)
            });
            const data = await readJsonResponse(response, 'Cập nhật quyết định');
            showToast(data.message || 'Đã cập nhật thành công.', 'success');
            window.location.assign(data.redirectUrl || window.location.href);
        } catch (error) {
            showToast(error.message, 'danger');
            if (submitButton) submitButton.disabled = false;
        }
    });

    renderResultsTable();
    refreshEmployeeEscalationQueue();
    setInterval(refreshEmployeeEscalationQueue, 5000);
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) refreshEmployeeEscalationQueue();
    });
    resumePendingReceipt();
</script>
