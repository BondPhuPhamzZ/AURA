@{
    ViewData["Title"] = "Cổng Thẩm Định (Harness)";
}

<div class="container mt-5">
    <h2>AURA - Auto Approval System (Verify Harness)</h2>
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Tabs cho Applicant (Nhân viên) và Reviewer (Sếp) -->
    <ul class="nav nav-tabs mt-4" id="auraTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="applicant-tab" data-bs-toggle="tab" data-bs-target="#applicant" type="button" role="tab">Giao Diện Nhân Viên (Nộp Đơn)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reviewer-tab" data-bs-toggle="tab" data-bs-target="#reviewer" type="button" role="tab">Giao Diện Quản Lý (Duyệt Ngoại Lệ)</button>
        </li>
    </ul>

    <div class="tab-content" id="auraTabsContent">
        <!-- Tab Nhân Viên -->
        <div class="tab-pane fade show active p-4 border border-top-0 bg-dark text-white" id="applicant" role="tabpanel">
            <h4>Nộp Hóa Đơn / Chứng Từ</h4>
            <p>Sử dụng các ảnh hóa đơn thật đã được map vào test_data</p>
            
            <form asp-controller="Applicant" asp-action="UploadReceipt" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Tải ảnh hóa đơn (.jpg, .png, .pdf)</label>
                    <input type="file" name="receiptFile" class="form-control" accept=".jpg,.png,.pdf" required />
                </div>
                <button type="submit" class="btn btn-primary">Chạy AI Verify (Gửi Đơn)</button>
            </form>
        </div>

        <!-- Tab Quản Lý -->
        <div class="tab-pane fade p-4 border border-top-0 bg-dark text-white" id="reviewer" role="tabpanel">
            @await Component.InvokeAsync("EscalationQueue")
        </div>
    </div>
</div>
