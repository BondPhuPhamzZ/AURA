    // Keep the idempotency key briefly across a same-tab reload if the server committed a
    // request but every HTTP response was lost. Only the local digest and opaque UUID are kept.
    async function getPendingUploadIdentity(file) {
        const idempotencyKey = () => crypto.randomUUID();
        if (!crypto.subtle)
            return { idempotencyKey: idempotencyKey(), fingerprint: null };

        const digest = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
        const fingerprint = Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
        const storageKey = 'aura.pendingUploadKeys';
        let pending = {};
        try {
            const parsed = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) pending = parsed;
        } catch { pending = {}; }

        const existing = pending[fingerprint];
        if (existing && typeof existing.key === 'string')
            return { idempotencyKey: existing.key, fingerprint };

        const key = idempotencyKey();
        pending[fingerprint] = { key, createdAt: Date.now() };
        const entries = Object.entries(pending).sort((left, right) =>
            (Number(left[1]?.createdAt) || 0) - (Number(right[1]?.createdAt) || 0));
        while (entries.length > 10) delete pending[entries.shift()[0]];
        try { sessionStorage.setItem(storageKey, JSON.stringify(pending)); }
        catch { /* Same-page automatic retries still reuse the in-memory key. */ }
        return { idempotencyKey: key, fingerprint };
    }

    function clearPendingUploadIdentity(fingerprint, idempotencyKey) {
        if (!fingerprint) return;
        const storageKey = 'aura.pendingUploadKeys';
        try {
            const pending = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
            if (pending[fingerprint]?.key === idempotencyKey) delete pending[fingerprint];
            sessionStorage.setItem(storageKey, JSON.stringify(pending));
        } catch { /* A stale tab entry expires with the browser session. */ }
    }

    // A multi-file selection reuses the same validated HTTP 202 endpoint. This keeps storage,
    // hash checks, SQL queueing and worker behavior on one code path.
    async function submitUpload() {
        if (!fileInput.files || fileInput.files.length === 0) {
            showToast('Vui lòng chọn ít nhất một ảnh hóa đơn.', 'danger');
            return;
        }
        if (!validateSelectedFiles(fileInput.files)) return;
        const files = Array.from(fileInput.files);

        const btn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = `Đang tiếp nhận ${files.length} ảnh...`;
        renderExtractedFactsLoading('AURA đang kiểm tra và tiếp nhận các hóa đơn…');
        beginAnalysisProgress(`Đang tiếp nhận ${files.length} hóa đơn`,
            'Mỗi ảnh đi qua cùng lớp kiểm file, lưu riêng tư, SHA-256 và SQL queue trước khi AI xử lý.');

        currentAnalysisItems = [];
        processingPlaceholderRows = files.length;
        renderResultsTable();
        scrollToResults();

        const form = document.getElementById('uploadForm');
        const queued = [];

        try {
            for (const file of files) {
                const { idempotencyKey, fingerprint } = await getPendingUploadIdentity(file);
                let response;
                for (let attempt = 0; attempt < 3; attempt++) {
                    const formData = new FormData(form);
                    formData.delete('receiptFile');
                    formData.append('receiptFile', file, file.name);
                    try {
                        response = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Idempotency-Key': idempotencyKey },
                            body: formData
                        });
                    } catch (networkError) {
                        if (attempt === 2) throw networkError;
                        await new Promise(resolve => setTimeout(resolve, 500 * (attempt + 1)));
                        continue;
                    }
                    if (response.ok || (response.status < 500 && response.status !== 429)) break;
                    if (attempt === 2) break;
                    const retryAfter = Number(response.headers.get('Retry-After'));
                    const delayMs = Number.isFinite(retryAfter) && retryAfter > 0
                        ? Math.min(retryAfter, 30) * 1000
                        : 500 * (attempt + 1);
                    await new Promise(resolve => setTimeout(resolve, delayMs));
                }
                if (response.status >= 400 && response.status < 500)
                    clearPendingUploadIdentity(fingerprint, idempotencyKey);
                const data = await readJsonResponse(response, `Tải lên ${file.name}`);
                clearPendingUploadIdentity(fingerprint, idempotencyKey);
                queued.push(data);
                sessionStorage.setItem('aura.pendingReceipts', JSON.stringify(
                    queued.map(item => ({ caseId: item.caseId, statusUrl: item.statusUrl }))));
                currentAnalysisItems = [...queued];
                processingPlaceholderRows = files.length - queued.length;
                renderResultsTable();
            }

            processingPlaceholderRows = 0;
            sessionStorage.setItem('aura.pendingReceipts', JSON.stringify(
                queued.map(item => ({ caseId: item.caseId, statusUrl: item.statusUrl }))));
            showToast(`Đã ghi nhận ${queued.length} hồ sơ. AI xử lý nền theo SQL queue.`, 'success');

            const completedItems = [];
            for (const item of queued) {
                const completed = await pollReceiptStatus(item.statusUrl, true);
                completedItems.push(completed);
            }
            sessionStorage.removeItem('aura.pendingReceipts');
            sessionStorage.removeItem('aura.pendingReceipt');

            const firstFacts = completedItems.find(item => item.facts);
            if (firstFacts) showAnalysisFacts(firstFacts.caseId, false);
            else renderExtractedFactsUnavailable('AI chưa trả về dữ kiện; các hồ sơ đã được chuyển sang kiểm tra thủ công.');
            updateAnalysisSummary(completedItems);
            finishAnalysisProgress(`Đã hoàn tất ${completedItems.length} hóa đơn`,
                'Kết quả, privacy triage và route đã được lưu; ca cần xử lý vẫn chờ nhân viên chuyển tiếp.');
            await refreshEmployeeEscalationQueue();
        } catch(e) {
            processingPlaceholderRows = 0;
            renderResultsTable();
            const accepted = queued.length > 0 ? ` ${queued.length} hồ sơ đã nhận vẫn được xử lý nền.` : '';
            renderExtractedFactsUnavailable('Không thể tiếp nhận toàn bộ lượt ảnh: ' + e.message + accepted);
            finishAnalysisProgress('Lượt ảnh chưa được tiếp nhận đầy đủ', e.message + accepted, true);
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    async function pollReceiptStatus(statusUrl, preserveBatch = false) {
        if (!statusUrl) throw new Error('Máy chủ không trả về địa chỉ theo dõi hồ sơ.');
        for (let attempt = 0; attempt < 900; attempt++) {
            await window.AuraWorkflow.whenApplicantVisible();
            const response = await fetch(statusUrl, { cache: 'no-store' });
            const item = await readJsonResponse(response, 'Theo dõi trạng thái AI');
            if (preserveBatch) upsertCurrentAnalysisItem(item);
            else setCurrentAnalysisItems(item);
            if (item.processingState === 'COMPLETED' || item.processingState === 'FAILED') return item;
            await new Promise(resolve => setTimeout(resolve, 1000));
        }
        throw new Error('Hồ sơ vẫn đang xử lý sau 15 phút. Có thể tải lại trang để tiếp tục theo dõi.');
    }

    async function resumePendingReceipt() {
        const raw = sessionStorage.getItem('aura.pendingReceipts') || sessionStorage.getItem('aura.pendingReceipt');
        if (!raw) return;
        try {
            const parsed = JSON.parse(raw);
            const pendingItems = Array.isArray(parsed) ? parsed : [parsed];
            beginAnalysisProgress(`Đang khôi phục ${pendingItems.length} hồ sơ chưa hoàn tất`,
                'Hàng đợi vẫn chạy trong nền; bảng sẽ tự cập nhật khi có kết quả.');
            currentAnalysisItems = pendingItems.map(item => ({
                caseId: item.caseId,
                image: 'Hồ sơ đang khôi phục',
                processingState: 'PENDING',
                reason: 'Đang đọc lại trạng thái từ SQL queue.'
            }));
            renderResultsTable();
            const completedItems = [];
            for (const pending of pendingItems)
                completedItems.push(await pollReceiptStatus(pending.statusUrl, true));
            sessionStorage.removeItem('aura.pendingReceipts');
            sessionStorage.removeItem('aura.pendingReceipt');
            const firstFacts = completedItems.find(item => item.facts);
            if (firstFacts) showAnalysisFacts(firstFacts.caseId, false);
            updateAnalysisSummary(completedItems);
            finishAnalysisProgress('Đã khôi phục kết quả thẩm định',
                'Các hồ sơ đã hoàn tất hoặc được chuyển sang kiểm tra thủ công.');
            await refreshEmployeeEscalationQueue();
        } catch (error) {
            showToast('Không thể khôi phục trạng thái xử lý: ' + error.message, 'warning');
            finishAnalysisProgress('Không thể khôi phục trạng thái', error.message, true);
        }
    }
    
    // Verify Harness logic (AJAX)
    async function startVerifyHarness() {
        const btn = document.getElementById('verifyHarnessButton');
        const btnText = document.getElementById('btnVerifyText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = 'Đang chạy 5 hóa đơn...';
        renderExtractedFactsLoading('AI đang lần lượt xử lý 5 ca Verify Harness…', 'Verify Harness');
        beginAnalysisProgress('Verify Harness đang chạy 5 ca',
            'Các ca được xử lý tuần tự để hạn chế rate limit. Bảng sẽ cập nhật sau khi cả batch hoàn tất.');
        currentAnalysisItems = [];
        processingPlaceholderRows = 5;
        renderResultsTable();
        scrollToResults();
        
        const dummyForm = document.getElementById('verifyFormDummy');
        const formData = new FormData(dummyForm);
        
        try {
            const response = await fetch(dummyForm.action, {
                method: 'POST',
                body: formData
            });

            const data = await readJsonResponse(response, 'Verify Harness');
            
            if (data.error) {
                processingPlaceholderRows = 0;
                renderResultsTable();
                finishAnalysisProgress('Verify Harness không hoàn tất', data.error, true);
                return;
            }

            setCurrentAnalysisItems(data);
            const firstExtractedResult = data.find(item => item?.facts);
            if (firstExtractedResult) {
                showAnalysisFacts(firstExtractedResult.caseId, false);
            } else {
                renderExtractedFactsUnavailable('Verify Harness đã hoàn tất nhưng AI không trả về dữ liệu trích xuất cho bất kỳ ca nào. Hãy kiểm tra thông báo lỗi, quota hoặc cấu hình model.', 'Verify Harness');
                showToast('Không có nội dung AI nào được trả về trong lượt Verify này.', 'warning');
            }
            updateAnalysisSummary(data);
            finishAnalysisProgress('Verify Harness đã hoàn tất',
                'Chọn “Xem dữ kiện” tại từng dòng để đối chiếu nội dung AI của cả 5 ca; các ca escalation vẫn ở bảng cho tới khi chuyển tiếp.');
            await refreshEmployeeEscalationQueue();
            scrollToResults();
        } catch(e) {
            processingPlaceholderRows = 0;
            renderResultsTable();
            renderExtractedFactsUnavailable('Verify Harness không nhận được nội dung từ AI: ' + e.message, 'Verify Harness');
            finishAnalysisProgress('Verify Harness không hoàn tất', e.message, true);
            scrollToResults();
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    document.addEventListener('submit', async event => {
        const form = event.target.closest('.js-workflow-form');
        if (!form) return;
        event.preventDefault();
        if (!window.AuraWorkflow?.beginMutation()) return;
        const submitButton = event.submitter || form.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
        try {
            const response = await window.AuraWorkflow.post(form.action, new FormData(form));
            const data = await readJsonResponse(response, 'Cập nhật quyết định');
            showToast(data.message || 'Đã cập nhật thành công.', 'success');
            window.AuraWorkflow.confirmMutation();
        } catch (error) {
            showToast('Chưa xác nhận được thao tác: ' + error.message, 'danger');
        } finally {
            if (submitButton) submitButton.disabled = false;
            await window.AuraWorkflow.endMutation();
        }
    });

    renderResultsTable();
    document.addEventListener('aura:workflowready', resumePendingReceipt, { once: true });
</script>
