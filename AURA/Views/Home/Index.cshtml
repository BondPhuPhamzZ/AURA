    function renderResultRow(item) {
        const isProcessing = item.processingState === 'PENDING' || item.processingState === 'PROCESSING';
        const passBadge = item.pass == null
            ? '<span class="badge bg-secondary">KHÔNG ÁP DỤNG</span>'
            : item.pass ? '<span class="badge bg-success">PASS</span>' : '<span class="badge bg-danger">FAIL</span>';
        let expectedBadge = item.expected
            ? '<span class="badge bg-secondary">' + escapeHtml(item.expected) + '</span>'
            : '<span class="text-muted">Không áp dụng</span>';
        if(item.expected === 'AUTO_APPROVE') expectedBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.expected && item.expected.startsWith('ESCALATE')) expectedBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.expected) + '</span>';
        
        let actualBadge = isProcessing
            ? '<span class="badge bg-info text-dark">ĐANG XỬ LÝ</span>'
            : '<span class="badge bg-secondary">' + escapeHtml(item.actual || 'CHƯA CÓ') + '</span>';
        if(item.actual === 'AUTO_APPROVE') actualBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.actual && item.actual.startsWith('ESCALATE_')) actualBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.actual) + '</span>';
        if(item.actual === 'ESCALATE_SYSTEM_ERROR') actualBadge = '<span class="badge bg-danger">SYSTEM_ERROR</span>';
        
        const workflowAction = isProcessing
            ? '<span class="text-muted">Đang chờ</span>'
            : item.canForward
            ? '<button type="button" class="button-primary button-compact" onclick="forwardToManager(\'' + escapeJsString(item.caseId) + '\', this)">Chuyển tiếp</button>'
            : '<span class="text-muted">Không cần</span>';
        const factsAction = item.facts
            ? '<button type="button" class="button-ghost-sm facts-view-button" aria-pressed="' +
              (selectedFactsCaseId === item.caseId ? 'true' : 'false') + '" onclick="showAnalysisFacts(\'' + escapeJsString(item.caseId) + '\')">Xem dữ kiện</button>'
            : '';
        const receipt = item.receiptUrl
            ? '<a class="receipt-preview-link" href="' + escapeHtml(item.receiptUrl) + '" target="_blank" rel="noopener">' +
              '<img class="receipt-thumbnail" src="' + escapeHtml(item.receiptUrl) + '" alt="Ảnh chứng từ ' + escapeHtml(item.image) + '" loading="lazy" />' +
              '<span>' + escapeHtml(item.image) + '</span></a>'
            : escapeHtml(item.image);
        const handoffText = item.canForward ? (item.handoffPrompt || '') : (item.question || '');

        const rowClass = selectedFactsCaseId === item.caseId ? ' class="facts-selected"' : '';
        return '<tr' + rowClass + ' data-case-id="' + escapeHtml(item.caseId || '') + '" data-can-forward="' +
            (item.canForward ? 'true' : 'false') + '" data-row-source="current-analysis">' +
            '<td data-label="Mã hồ sơ" class="cell-code">' + escapeHtml(item.caseId ? item.caseId.substring(0,8) : '') + '</td>' +
            '<td data-label="Ảnh">' + receipt + '</td>' +
            '<td data-label="Kỳ vọng">' + expectedBadge + '</td>' +
            '<td data-label="Kết quả">' + actualBadge + '</td>' +
            '<td data-label="Đối chiếu">' + passBadge + '</td>' +
            '<td data-label="Lý do và câu hỏi" class="cell-reason"><strong>' + escapeHtml(item.reason) + '</strong><small>' + escapeHtml(handoffText) + '</small></td>' +
            '<td data-label="Độ trễ" class="cell-number">' + (item.latencyMs == null ? '—' : escapeHtml(item.latencyMs) + ' ms') + '</td>' +
            '<td data-label="Thao tác" class="cell-actions"><div class="result-row-actions">' + factsAction + workflowAction + '</div></td>' +
        '</tr>';
    }

    function getAnalysisFactsLabel(item) {
        const testCase = item?.testCaseId ? String(item.testCaseId) : '';
        const image = item?.image ? String(item.image) : '';
        return [testCase, image].filter(Boolean).join(' · ') || 'hồ sơ đã chọn';
    }

    function showAnalysisFacts(caseId, shouldScroll = true) {
        const item = currentAnalysisItems.find(candidate => candidate?.caseId === caseId);
        if (!item?.facts) {
            renderExtractedFactsUnavailable('Ca này chưa có dữ kiện trích xuất để hiển thị.', getAnalysisFactsLabel(item));
            return;
        }

        selectedFactsCaseId = caseId;
        renderExtractedFacts(item.facts, getAnalysisFactsLabel(item));
        document.querySelectorAll('#resultsBody tr[data-row-source="current-analysis"]').forEach(row => {
            const selected = row.dataset.caseId === caseId;
            row.classList.toggle('facts-selected', selected);
            row.querySelector('.facts-view-button')?.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });

        if (shouldScroll) {
            document.querySelector('.extracted-facts-column')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value == null ? '' : String(value);
        return element.innerHTML;
    }

    function escapeJsString(value) {
        return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }

    function renderResultsTable() {
        const currentIds = new Set(currentAnalysisItems
            .map(item => item?.caseId)
            .filter(Boolean));
        const currentHtml = currentAnalysisItems.map(renderResultRow).join('');
        const placeholderHtml = Array.from({ length: processingPlaceholderRows }, getSkeletonRow).join('');
        const persistedHtml = persistedEscalationRows
            .filter(row => row.caseId && !currentIds.has(row.caseId))
            .map(row => row.html)
            .join('');

        resultsBody.innerHTML = currentHtml + placeholderHtml + persistedHtml || emptyResultsRow;
        updatePendingEscalationSummary();
        window.AuraWorkflow?.rendered();
    }

    function setCurrentAnalysisItems(items) {
        currentAnalysisItems = (Array.isArray(items) ? items : [items]).filter(Boolean);
        if (!currentAnalysisItems.some(item => item?.caseId === selectedFactsCaseId && item?.facts)) {
            selectedFactsCaseId = null;
        }
        processingPlaceholderRows = 0;
        renderResultsTable();
    }

    function upsertCurrentAnalysisItem(item) {
        const index = currentAnalysisItems.findIndex(candidate => candidate?.caseId === item?.caseId);
        if (index >= 0) currentAnalysisItems[index] = item;
        else currentAnalysisItems.push(item);
        renderResultsTable();
    }

    async function refreshEmployeeEscalationQueue() {
        return window.AuraWorkflow?.refresh('applicant');
    }

    // A committed server fragment is authoritative; remove locally cached rows
    // that were forwarded/decided elsewhere without discarding running uploads.
    function applyEmployeeEscalationFragment(html) {
        const container = document.createElement('tbody');
        container.innerHTML = html;
        persistedEscalationRows = Array.from(container.querySelectorAll('tr[data-case-id]'))
            .map(row => ({ caseId: row.dataset.caseId, html: row.outerHTML }));
        const pendingIds = new Set(persistedEscalationRows.map(row => row.caseId));
        currentAnalysisItems = currentAnalysisItems.filter(item =>
            !item.actual?.startsWith('ESCALATE_') || pendingIds.has(item.caseId));
        renderResultsTable();
    }

    function beginAnalysisProgress(title, detail) {
        const notice = document.getElementById('analysisProgressNotice');
        notice.hidden = false;
        notice.classList.remove('is-complete', 'is-error');
        notice.setAttribute('aria-busy', 'true');
        document.getElementById('analysisProgressTitle').textContent = title;
        document.getElementById('analysisProgressDetail').textContent = detail;
        analysisProgressStartedAt = Date.now();
        clearInterval(analysisProgressTimer);
        const updateElapsed = () => {
            const seconds = Math.max(0, Math.floor((Date.now() - analysisProgressStartedAt) / 1000));
            document.getElementById('analysisProgressElapsed').textContent = `Đã chờ ${seconds}s`;
        };
        updateElapsed();
        analysisProgressTimer = setInterval(updateElapsed, 1000);
    }

    function finishAnalysisProgress(title, detail, isError = false) {
        clearInterval(analysisProgressTimer);
        analysisProgressTimer = null;
        const notice = document.getElementById('analysisProgressNotice');
        notice.hidden = false;
        notice.classList.toggle('is-complete', !isError);
        notice.classList.toggle('is-error', isError);
        notice.setAttribute('aria-busy', 'false');
        document.getElementById('analysisProgressTitle').textContent = title;
        document.getElementById('analysisProgressDetail').textContent = detail;
        document.getElementById('analysisProgressElapsed').textContent = '';
    }

    function updateAnalysisSummary(items) {
        const rows = Array.isArray(items) ? items : [items];
        const approved = rows.filter(item => item?.actual === 'AUTO_APPROVE').length;
        const escalated = rows.filter(item => item?.actual?.startsWith('ESCALATE_')).length;
        updatePendingEscalationSummary();
        showToast(`Đã phân tích ${rows.length} hồ sơ: ${approved} tự động duyệt, ${escalated} cần chuyển tiếp.`,
            escalated > 0 ? 'warning' : 'success');
    }

    function updatePendingEscalationSummary() {
        const approvedCount = currentAnalysisItems.filter(item => item?.actual === 'AUTO_APPROVE').length;
        const pendingCount = document.querySelectorAll('#resultsBody tr[data-can-forward="true"]').length;
        const summary = document.getElementById('analysisSummary');
        if (approvedCount === 0 && pendingCount === 0 && currentAnalysisItems.length === 0 && processingPlaceholderRows === 0) {
            summary.innerHTML = '<span class="summary-placeholder">Chưa có lượt phân tích mới.</span>';
            return;
        }
        summary.innerHTML = '<span class="summary-approved">' + approvedCount + ' tự động duyệt trong lượt hiện tại</span>' +
            '<span class="summary-escalated">' + pendingCount + ' đang chờ chuyển tiếp</span>';
    }

    async function readJsonResponse(response, context) {
        const rawBody = await response.text();
        let payload = null;

        if (rawBody.trim()) {
            try {
                payload = JSON.parse(rawBody);
            } catch {
                if (!response.ok) {
                    if (response.status === 409)
                        throw new Error('Hồ sơ đã thay đổi ở thao tác khác. Đang đọc lại trạng thái từ máy chủ.');
                    throw new Error(`${context} thất bại (HTTP ${response.status}); máy chủ trả về phản hồi không đúng định dạng.`);
                }
                throw new Error(`${context} nhận được phản hồi JSON không hợp lệ từ máy chủ.`);
            }
        }

        if (!response.ok) {
            if (response.status === 413) {
                throw new Error(`Ảnh vượt quá giới hạn ${maxUploadMegabytes} MB.`);
            }
            throw new Error(payload?.error || `${context} thất bại (HTTP ${response.status}).`);
        }

        if (payload === null) {
            throw new Error(`${context} không nhận được dữ liệu phản hồi từ máy chủ.`);
        }

        return payload;
    }

