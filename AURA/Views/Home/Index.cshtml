@{
    ViewData["Title"] = "Dashboard";
}
@using AURA.Options
@using Microsoft.Extensions.Options
@inject IOptions<ReceiptStorageOptions> ReceiptStorage

<!-- Tab Applicant / Tester -->
<div class="tab-content-pane feature-card active" id="pane-applicant" style="padding: 24px;">
    
    <!-- Hướng dẫn & Verify Harness (Top Section) -->
    <div class="section-heading-row verify-heading-row">
        <div class="verify-copy">
            <h2 class="hero-title" style="font-size: 1.5rem; margin-bottom: 8px;">Kiểm Thử Tự Động (Verify Harness)</h2>
            <p class="hero-sub" style="color: var(--colors-ink-subtle); margin: 0; font-size: 0.95rem;">
                Nhấn nút bên phải để AI tự động chạy kiểm thử trên bộ 5 hóa đơn chuẩn hóa. Bạn cũng có thể tải lên 1 hóa đơn thủ công ở khung bên dưới.
            </p>
        </div>
        <div class="verify-action">
            <button type="button" id="verifyHarnessButton" class="button-primary verify-primary-button" onclick="startVerifyHarness()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3l14 9-14 9V3z"/></svg>
                <span id="btnVerifyText">Chạy Verify Harness (90s)</span>
            </button>
            <form id="verifyFormDummy" asp-controller="Verify" asp-action="RunHarness" method="post" style="display: none;">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>

    <!-- Upload Thủ Công (Middle Section) -->
    <section class="workflow-section upload-section" aria-labelledby="single-upload-title">
        <h3 id="single-upload-title" style="font-size: 1.1rem; margin-bottom: 16px;">Hoặc tải lên hóa đơn kiểm thử lẻ:</h3>
        
        <form id="uploadForm" asp-controller="Applicant" asp-action="UploadReceipt" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <div class="upload-workspace">
                <div class="upload-input-column">
                    <div class="dropzone-area" id="dropzone" onclick="document.getElementById('receiptFile').click()">
                        <input type="file" id="receiptFile" name="receiptFile" accept=".jpg,.jpeg,.png" style="display: none;" onchange="handleFileSelect(this)">
                        <img id="receiptLocalPreview" class="receipt-local-preview" alt="Xem trước hóa đơn đã chọn" hidden />
                        <div class="dropzone-placeholder" id="dropzonePlaceholder">
                            <div class="dropzone-icon">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            </div>
                            <div class="dropzone-text" id="dropzoneText">Kéo thả ảnh hóa đơn vào đây</div>
                            <div class="dropzone-subtext">Hỗ trợ JPG, PNG (Tối đa @ReceiptStorage.Value.MaxFileSizeMb MB)</div>
                        </div>
                    </div>
                    <div class="amount-action-row">
                        <div class="amount-field">
                            <label for="claimedAmountDisplay" class="form-label fw-semibold">Số tiền nhân viên đề nghị hoàn ứng (VND)</label>
                            <input id="claimedAmountDisplay" type="text" inputmode="numeric" autocomplete="off" required
                                   class="form-control amount-input-aura" placeholder="Ví dụ: 150.000" aria-describedby="claimedAmountHelp" />
                            <input id="claimedAmount" name="claimedAmount" type="hidden" />
                            <div id="claimedAmountHelp" class="form-text">
                                Nhập số tiền thực tế nhân viên yêu cầu. Hệ thống tự thêm dấu chấm phân cách hàng nghìn.
                            </div>
                        </div>
                        <div class="amount-submit-wrap">
                            <button type="submit" id="submitBtn" class="button-primary">
                                <span id="btnText">AI tự động kiểm</span>
                            </button>
                        </div>
                    </div>
                </div>

                <section class="extracted-facts-panel" aria-labelledby="extracted-facts-title" aria-live="polite">
                    <div class="extracted-facts-heading">
                        <h4 id="extracted-facts-title">Nội dung AI đọc được</h4>
                        <span id="extractedFactsConfidence" class="badge bg-secondary">Chưa quét</span>
                    </div>
                    <div id="extractedFactsBody" class="extracted-facts-empty">
                        Kết quả trích xuất sẽ xuất hiện tại đây sau khi AI xử lý ảnh. Giá trị không đọc chắc chắn được hiển thị là “Không đọc được”, không tự suy đoán.
                    </div>
                </section>
            </div>
        </form>
    </section>

    <!-- Bảng Kết Quả Hợp Nhất (Bottom Section) -->
    <section id="unifiedResultsSection" class="workflow-section results-section">
        <div class="section-heading-row compact">
            <div>
                <h3 style="font-size: 1.25rem; margin: 0;">Bảng Kết Quả Thẩm Định</h3>
                <div id="analysisSummary" class="analysis-summary" role="status" aria-live="polite">
                    Chưa có lượt phân tích mới.
                </div>
            </div>
            <div class="results-heading-actions">
                <button type="button" class="button-primary button-compact" onclick="forwardAllToManager(this)">Chuyển tiếp tất cả</button>
                <button type="button" class="button-ghost-sm history-button" onclick="navigateToTab('audit')">Xem Lịch Sử</button>
            </div>
        </div>
        
        <p class="table-caption">
            Ca tự động duyệt được ghi thẳng vào lịch sử. Ca cần xử lý được giữ tại đây cho tới khi nhân viên chuyển tiếp. <strong>Kỳ vọng/Đối chiếu</strong> chỉ dùng trong lượt Verify có nhãn sẵn.
        </p>
        <div class="table-responsive-aura table-scroll-area">
            <table class="table-aura results-table">
                <thead>
                    <tr>
                        <th>Mã hồ sơ</th>
                        <th>Ảnh</th>
                        <th title="Kết quả chuẩn chỉ tồn tại ở bộ Verify">Kỳ vọng kiểm thử</th>
                        <th>Kết quả hệ thống</th>
                        <th title="So sánh Actual với Expected trong Verify">Đối chiếu</th>
                        <th>Lý do và câu hỏi</th>
                        <th>Độ trễ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="resultsBody">
                    @await Component.InvokeAsync("EmployeeEscalationQueue")
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- Tab Reviewer -->
<div class="tab-content-pane feature-card" id="pane-reviewer" style="display: none;">
    <div id="reviewerQueueHost">@await Component.InvokeAsync("EscalationQueue")</div>
</div>

<!-- Tab Audit Log -->
<div class="tab-content-pane feature-card" id="pane-audit" style="display: none;">
    <div id="auditTrailHost">@await Component.InvokeAsync("AuditLogQueue")</div>
</div>

<style>
    /* CSS for skeleton loading animation */
    .skeleton-row td {
        position: relative;
        overflow: hidden;
    }
    .skeleton-row td::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
        animation: loading 1.5s infinite;
    }
    @@keyframes loading {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    .skeleton-text {
        height: 16px;
        background-color: var(--colors-surface-alt);
        border-radius: 4px;
        width: 80%;
    }
</style>

<script>
    // Drag & Drop logic for upload
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('receiptFile');
    const dropzoneText = document.getElementById('dropzoneText');
    const dropzoneSubtext = document.querySelector('.dropzone-subtext');
    const receiptLocalPreview = document.getElementById('receiptLocalPreview');
    const dropzonePlaceholder = document.getElementById('dropzonePlaceholder');
    const uploadForm = document.getElementById('uploadForm');
    const amountDisplayInput = document.getElementById('claimedAmountDisplay');
    const amountRawInput = document.getElementById('claimedAmount');
    const maxUploadBytes = @((long)ReceiptStorage.Value.MaxFileSizeMb * 1024L * 1024L);
    const maxUploadMegabytes = @ReceiptStorage.Value.MaxFileSizeMb;
    let preserveVerifyResults = false;
    let localPreviewUrl = null;

    function syncClaimedAmount() {
        const digits = amountDisplayInput.value.replace(/\D/g, '').replace(/^0+(?=\d)/, '');
        amountRawInput.value = digits;
        amountDisplayInput.value = digits ? new Intl.NumberFormat('vi-VN').format(Number(digits)) : '';
        return digits;
    }

    amountDisplayInput.addEventListener('input', syncClaimedAmount);

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
        dropzone.classList.add('dragover');
    }

    function unhighlight(e) {
        dropzone.classList.remove('dragover');
    }

    dropzone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0 && validateSelectedFile(files[0])) {
            fileInput.files = files;
            updateDropzoneUI(files[0]);
        }
    }

    function handleFileSelect(input) {
        if (input.files && input.files.length > 0) {
            if (validateSelectedFile(input.files[0])) {
                updateDropzoneUI(input.files[0]);
            } else {
                input.value = '';
            }
        }
    }

    function validateSelectedFile(file) {
        if (!file) return false;
        const extension = file.name.split('.').pop()?.toLowerCase();
        if (!['jpg', 'jpeg', 'png'].includes(extension)) {
            showToast('Chỉ chấp nhận ảnh JPG hoặc PNG.', 'danger');
            return false;
        }
        if (file.size > maxUploadBytes) {
            showToast(`Ảnh vượt quá giới hạn ${maxUploadMegabytes} MB. Vui lòng nén ảnh hoặc chọn ảnh nhỏ hơn.`, 'danger');
            return false;
        }
        return true;
    }

    function updateDropzoneUI(file) {
        if (localPreviewUrl) URL.revokeObjectURL(localPreviewUrl);
        localPreviewUrl = URL.createObjectURL(file);
        receiptLocalPreview.src = localPreviewUrl;
        receiptLocalPreview.hidden = false;
        dropzonePlaceholder.classList.add('with-preview');
        dropzone.classList.add('has-preview');
        dropzoneText.textContent = file.name;
        dropzoneSubtext.innerText = 'Click hoặc kéo thả ảnh khác để thay đổi';
        renderExtractedFacts(null);
    }

    uploadForm.addEventListener('submit', event => {
        event.preventDefault();
        submitUpload();
    });

    function displayFact(value) {
        return value == null || String(value).trim() === '' ? 'Không đọc được' : String(value);
    }

    function formatFactMoney(value) {
        return value == null ? 'Không đọc được' : new Intl.NumberFormat('vi-VN').format(Number(value)) + ' VND';
    }

    function renderExtractedFacts(facts) {
        const body = document.getElementById('extractedFactsBody');
        const confidence = document.getElementById('extractedFactsConfidence');
        if (!facts) {
            confidence.className = 'badge bg-secondary';
            confidence.textContent = 'Chưa quét';
            body.className = 'extracted-facts-empty';
            body.textContent = 'Kết quả trích xuất sẽ xuất hiện tại đây sau khi AI xử lý ảnh. Giá trị không đọc chắc chắn được hiển thị là “Không đọc được”, không tự suy đoán.';
            return;
        }

        const confidencePercent = Math.round(Number(facts.confidence || 0) * 100);
        confidence.className = 'badge ' + (confidencePercent >= 70 ? 'bg-success' : 'bg-warning text-dark');
        confidence.textContent = `Tin cậy ${confidencePercent}%`;
        const identifier = facts.invoiceNumber || facts.orderId || facts.bookingId || facts.shippingTrackingCode;
        const evidenceDate = facts.invoiceDate || facts.transactionDate || facts.completionDate;
        const items = Array.isArray(facts.lineItems) && facts.lineItems.length
            ? '<ul class="extracted-line-items">' + facts.lineItems.map(item =>
                '<li><span>' + escapeHtml(displayFact(item.description)) + '</span><strong>' + escapeHtml(formatFactMoney(item.amount)) + '</strong></li>').join('') + '</ul>'
            : '<span class="fact-value missing">Không đọc được dòng hàng</span>';
        const warnings = [...(facts.missingFields || []), ...(facts.warnings || []), ...(facts.suspiciousSignals || [])];

        body.className = 'extracted-facts-content';
        body.innerHTML =
            '<dl class="extracted-facts-grid">' +
                '<div><dt>Loại chứng từ</dt><dd>' + escapeHtml(displayFact(facts.documentType)) + '</dd></div>' +
                '<div><dt>Đơn vị bán</dt><dd>' + escapeHtml(displayFact(facts.merchantName)) + '</dd></div>' +
                '<div><dt>Số HĐ / mã truy vết</dt><dd>' + escapeHtml(displayFact(identifier)) + '</dd></div>' +
                '<div><dt>Mã số thuế</dt><dd>' + escapeHtml(displayFact(facts.taxId)) + '</dd></div>' +
                '<div><dt>Ngày chứng từ</dt><dd>' + escapeHtml(displayFact(evidenceDate)) + '</dd></div>' +
                '<div><dt>Tổng tiền</dt><dd>' + escapeHtml(formatFactMoney(facts.totalAmount)) + '</dd></div>' +
                '<div><dt>Tiền tệ</dt><dd>' + escapeHtml(displayFact(facts.currency)) + '</dd></div>' +
                '<div><dt>Trạng thái</dt><dd>' + escapeHtml(displayFact(facts.documentStatus || facts.orderStatus)) + '</dd></div>' +
            '</dl>' +
            '<div class="extracted-items-block"><strong>Dòng hàng AI nhận diện</strong>' + items + '</div>' +
            (warnings.length ? '<div class="extracted-warning"><strong>Cần lưu ý:</strong> ' + escapeHtml(warnings.join('; ')) + '</div>' : '');
    }

    function getSkeletonRow() {
        return '<tr class="skeleton-row">' +
            '<td><div class="skeleton-text" style="width: 40px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 100px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 50px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 100%;"></div><div class="skeleton-text" style="width: 60%; margin-top: 4px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 60px;"></div></td>' +
            '<td><div class="skeleton-text" style="width: 80px;"></div></td>' +
            '</tr>';
    }

    function renderResultRow(item) {
        const passBadge = item.pass == null
            ? '<span class="badge bg-secondary">KHÔNG ÁP DỤNG</span>'
            : item.pass ? '<span class="badge bg-success">PASS</span>' : '<span class="badge bg-danger">FAIL</span>';
        let expectedBadge = item.expected
            ? '<span class="badge bg-secondary">' + escapeHtml(item.expected) + '</span>'
            : '<span class="text-muted">Không áp dụng</span>';
        if(item.expected === 'AUTO_APPROVE') expectedBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.expected && item.expected.startsWith('ESCALATE')) expectedBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.expected) + '</span>';
        
        let actualBadge = '<span class="badge bg-secondary">' + item.actual + '</span>';
        if(item.actual === 'AUTO_APPROVE') actualBadge = '<span class="badge bg-success">APPROVE</span>';
        if(item.actual && item.actual.startsWith('ESCALATE_')) actualBadge = '<span class="badge bg-warning text-dark">' + escapeHtml(item.actual) + '</span>';
        if(item.actual === 'ESCALATE_SYSTEM_ERROR') actualBadge = '<span class="badge bg-danger">SYSTEM_ERROR</span>';
        
        const action = item.canForward
            ? '<button type="button" class="button-primary button-compact" onclick="forwardToManager(\'' + escapeJsString(item.caseId) + '\', this)">Chuyển tiếp</button>'
            : '<span class="text-muted">Không cần</span>';
        const receipt = item.receiptUrl
            ? '<a class="receipt-preview-link" href="' + escapeHtml(item.receiptUrl) + '" target="_blank" rel="noopener">' +
              '<img class="receipt-thumbnail" src="' + escapeHtml(item.receiptUrl) + '" alt="Ảnh chứng từ ' + escapeHtml(item.image) + '" loading="lazy" />' +
              '<span>' + escapeHtml(item.image) + '</span></a>'
            : escapeHtml(item.image);
        const handoffText = item.canForward ? (item.handoffPrompt || '') : (item.question || '');

        return '<tr>' +
            '<td data-label="Mã hồ sơ" class="cell-code">' + escapeHtml(item.caseId ? item.caseId.substring(0,8) : '') + '</td>' +
            '<td data-label="Ảnh">' + receipt + '</td>' +
            '<td data-label="Kỳ vọng">' + expectedBadge + '</td>' +
            '<td data-label="Kết quả">' + actualBadge + '</td>' +
            '<td data-label="Đối chiếu">' + passBadge + '</td>' +
            '<td data-label="Lý do và câu hỏi" class="cell-reason"><strong>' + escapeHtml(item.reason) + '</strong><small>' + escapeHtml(handoffText) + '</small></td>' +
            '<td data-label="Độ trễ" class="cell-number">' + escapeHtml(item.latencyMs) + ' ms</td>' +
            '<td data-label="Thao tác" class="cell-actions">' + action + '</td>' +
        '</tr>';
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value == null ? '' : String(value);
        return element.innerHTML;
    }

    function escapeJsString(value) {
        return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }

    function updateAnalysisSummary(items) {
        const rows = Array.isArray(items) ? items : [items];
        const approved = rows.filter(item => item?.actual === 'AUTO_APPROVE').length;
        const escalated = rows.filter(item => item?.actual?.startsWith('ESCALATE_')).length;
        const summary = document.getElementById('analysisSummary');
        summary.innerHTML = '<span class="summary-approved">' + approved + ' tự động duyệt</span>' +
            '<span class="summary-escalated">' + escalated + ' cần chuyển tiếp</span>';
        showToast(`Đã phân tích ${rows.length} hồ sơ: ${approved} tự động duyệt, ${escalated} cần chuyển tiếp.`,
            escalated > 0 ? 'warning' : 'success');
    }

    async function refreshFragment(url, hostId, context) {
        const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' });
        if (!response.ok) throw new Error(`${context} thất bại (HTTP ${response.status}).`);
        document.getElementById(hostId).innerHTML = await response.text();
    }

    async function refreshPendingEscalations() {
        const response = await fetch('@Url.Action("EmployeeEscalations", "Home")', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store'
        });
        if (!response.ok) throw new Error(`Cập nhật bảng kết quả thất bại (HTTP ${response.status}).`);
        document.getElementById('resultsBody').innerHTML = await response.text();
    }

    async function refreshWorkflowViews(includeResults = true) {
        const tasks = [
            refreshFragment('@Url.Action("ReviewerQueue", "Home")', 'reviewerQueueHost', 'Cập nhật hàng đợi quản lý'),
            refreshFragment('@Url.Action("AuditTrail", "Home")', 'auditTrailHost', 'Cập nhật lịch sử')
        ];
        if (includeResults) tasks.push(refreshPendingEscalations());
        await Promise.all(tasks);
        window.initializeAuditFilter?.();
    }

    async function readJsonResponse(response, context) {
        const rawBody = await response.text();
        let payload = null;

        if (rawBody.trim()) {
            try {
                payload = JSON.parse(rawBody);
            } catch {
                if (!response.ok) {
                    throw new Error(`${context} thất bại (HTTP ${response.status}); máy chủ trả về phản hồi không đúng định dạng.`);
                }
                throw new Error(`${context} nhận được phản hồi JSON không hợp lệ từ máy chủ.`);
            }
        }

        if (!response.ok) {
            if (response.status === 413) {
                throw new Error(`Ảnh vượt quá giới hạn ${maxUploadMegabytes} MB.`);
            }
            throw new Error(payload?.error || `${context} thất bại (HTTP ${response.status}).`);
        }

        if (payload === null) {
            throw new Error(`${context} không nhận được dữ liệu phản hồi từ máy chủ.`);
        }

        return payload;
    }

    async function forwardToManager(caseId, button) {
        preserveVerifyResults = false;
        button.disabled = true;
        const originalText = button.innerText;
        button.innerText = 'Đang chuyển...';
        const formData = new FormData();
        formData.append('id', caseId);
        formData.append('__RequestVerificationToken', document.querySelector('#uploadForm input[name="__RequestVerificationToken"]').value);

        try {
            const response = await fetch('@Url.Action("ForwardToManager", "Applicant")', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            const data = await readJsonResponse(response, 'Chuyển tiếp hồ sơ');
            showToast(data.message, 'success');
            await refreshWorkflowViews(true);
        } catch (error) {
            showToast('Không thể chuyển tiếp: ' + error.message, 'danger');
            button.disabled = false;
            button.innerText = originalText;
        }
    }

    async function forwardAllToManager(button) {
        preserveVerifyResults = false;
        if (!confirm('Chuyển toàn bộ hồ sơ đang chờ đến quản lý?')) return;
        button.disabled = true;
        const originalText = button.innerText;
        button.innerText = 'Đang chuyển...';
        const formData = new FormData();
        formData.append('__RequestVerificationToken', document.querySelector('#uploadForm input[name="__RequestVerificationToken"]').value);
        try {
            const response = await fetch('@Url.Action("ForwardAllToManager", "Applicant")', {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: formData
            });
            const data = await readJsonResponse(response, 'Chuyển tiếp tất cả');
            showToast(data.message, 'success');
            await refreshWorkflowViews(true);
        } catch (error) {
            showToast('Không thể chuyển tiếp: ' + error.message, 'danger');
        } finally {
            button.disabled = false;
            button.innerText = originalText;
        }
    }

    function scrollToResults() {
        document.getElementById('unifiedResultsSection').scrollIntoView({ behavior: 'smooth' });
    }

    // AJAX Upload Single File
    async function submitUpload() {
        preserveVerifyResults = false;
        if (!fileInput.files || fileInput.files.length === 0) {
            showToast('Vui lòng tải lên ảnh hóa đơn.', 'danger');
            return;
        }
        if (!validateSelectedFile(fileInput.files[0])) return;
        const rawAmount = syncClaimedAmount();
        if (!rawAmount || Number(rawAmount) <= 0) {
            showToast('Vui lòng nhập số tiền đề nghị hoàn ứng hợp lệ.', 'danger');
            amountDisplayInput.focus();
            return;
        }

        const btn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = 'Đang xử lý...';
        
        // Keep the operator at the upload workspace; update only the dependent fragments.
        document.getElementById('resultsBody').innerHTML = getSkeletonRow();

        const form = document.getElementById('uploadForm');
        const formData = new FormData(form);
        formData.set('claimedAmount', rawAmount);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });

            const data = await readJsonResponse(response, 'Tải lên hóa đơn');
            renderExtractedFacts(data.facts);
            if (data.duplicateDetected && !data.duplicatePolicyEnabled) {
                showToast('Ảnh này đã từng được dùng; hệ thống vẫn xử lý vì đang bật chế độ kiểm thử.', 'warning');
            }
            
            if (data.error) {
                document.getElementById('resultsBody').innerHTML = '<tr><td colspan="8" class="text-danger text-center">Lỗi: ' + escapeHtml(data.error) + '</td></tr>';
            } else {
                document.getElementById('resultsBody').innerHTML = renderResultRow(data);
                updateAnalysisSummary(data);
                await refreshWorkflowViews(true);
            }
        } catch(e) {
            document.getElementById('resultsBody').innerHTML = '<tr><td colspan="8" class="text-danger text-center">Có lỗi hệ thống: ' + escapeHtml(e.message) + '</td></tr>';
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }
    
    // Verify Harness logic (AJAX)
    async function startVerifyHarness() {
        preserveVerifyResults = true;
        const btn = document.getElementById('verifyHarnessButton');
        const btnText = document.getElementById('btnVerifyText');
        const originalText = btnText.innerText;
        
        btn.disabled = true;
        btnText.innerText = 'Đang chạy 5 hóa đơn...';
        
        // Show 5 skeleton rows
        let skeletonHtml = '';
        for(let i=0; i<5; i++) {
            skeletonHtml += getSkeletonRow();
        }
        document.getElementById('resultsBody').innerHTML = skeletonHtml;
        scrollToResults();
        
        const dummyForm = document.getElementById('verifyFormDummy');
        const formData = new FormData(dummyForm);
        
        try {
            const response = await fetch(dummyForm.action, {
                method: 'POST',
                body: formData
            });

            const data = await readJsonResponse(response, 'Verify Harness');
            
            if (data.error) {
                document.getElementById('resultsBody').innerHTML = '<tr><td colspan="8" class="text-danger text-center">Lỗi: ' + escapeHtml(data.error) + '</td></tr>';
                return;
            }

            let html = '';
            data.forEach(item => {
                html += renderResultRow(item);
            });
            document.getElementById('resultsBody').innerHTML = html;
            renderExtractedFacts(data[0]?.facts || null);
            updateAnalysisSummary(data);
            await refreshWorkflowViews(false);
        } catch(e) {
            document.getElementById('resultsBody').innerHTML = '<tr><td colspan="8" class="text-danger text-center">Có lỗi xảy ra: ' + escapeHtml(e.message) + '</td></tr>';
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    document.addEventListener('submit', async event => {
        const form = event.target.closest('.js-workflow-form');
        if (!form) return;
        event.preventDefault();
        const submitButton = event.submitter || form.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form)
            });
            const data = await readJsonResponse(response, 'Cập nhật quyết định');
            showToast(data.message || 'Đã cập nhật thành công.', 'success');
            await refreshWorkflowViews(true);
        } catch (error) {
            showToast(error.message, 'danger');
            if (submitButton) submitButton.disabled = false;
        }
    });

    window.setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        refreshWorkflowViews(!preserveVerifyResults).catch(() => { /* polling must not interrupt the operator */ });
    }, 10000);
</script>
