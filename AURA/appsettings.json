{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AuraDb;Trusted_Connection=True;MultipleActiveResultSets=true;Connect Timeout=5;ConnectRetryCount=0"
  },
  "Vision": {
    "Provider": "OpenRouter",
    "FallbackEnabled": false,
    "FallbackProvider": "Ollama",
    "CircuitBreakFailureThreshold": 3,
    "CircuitBreakSeconds": 60,
    "MaxConcurrentRequests": 1,
    "ProviderCooldownSeconds": 120
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "ChatCompletionsPath": "chat/completions",
    "Model": "qwen/qwen3.8-flash",
    "PolicyPath": "BUSINESS_RULES.md",
    "TimeoutSeconds": 90,
    "MaxOutputTokens": 4096,
    "ReasoningEffort": "none",
    "DenyProviderDataCollection": true,
    "RequireZeroDataRetention": false,
    "HttpReferer": "https://github.com/BondPhuPhamzZ/AURA",
    "AppTitle": "AURA - The Escalation Referee"
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434/",
    "ChatPath": "api/chat",
    "Model": "qwen3-vl:4b-instruct",
    "PolicyPath": "BUSINESS_RULES.md",
    "TimeoutSeconds": 600,
    "MaxOutputTokens": 4096,
    "ContextTokens": 16384,
    "KeepAlive": "30m",
    "Think": false
  },
  "ReceiptStorage": {
    "Provider": "LocalFileSystem",
    "Directory": "App_Data/receipts",
    "MaxFileSizeMb": 5
  },
  "DecisionPolicy": {
    "EscalateDuplicateReceipts": false
  },
  "ReceiptProcessing": {
    "PollIntervalMs": 5000,
    "LeaseSeconds": 600,
    "FailureBackoffMaxSeconds": 60,
    "MaxOutstandingReceipts": 1000
  },
  "DataRetention": {
    "Enabled": false,
    "SweepIntervalMinutes": 5,
    "BatchSize": 25
  },
  "Verify": {
    "InterCaseDelayMs": 4000,
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DriveSandbox": {
    "Enabled": false,
    "PollIntervalSeconds": 120,
    "MaxFilesPerScan": 100,
    "RequireMalwareScanner": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Critical",
      "Microsoft.EntityFrameworkCore.Query": "Critical"
    }
  },
  "AllowedHosts": "*"
}


