<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>08f53e32-7807-49ad-95ed-4c2f1cef5c44</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Never let generated/local evaluation folders become publish inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;.tmp\**;.codex_tmp\**;test_kit\**;TestResults\**;App_Data\**;Properties\PublishProfiles\**;**\appsettings.Secrets.json;**\appsettings.Production.local.json;**\*service-account*.json;**\client_secret*.json</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime data belongs to the host, never to build/deployment artifacts. -->
    <Content Remove="App_Data\**\*" />
    <None Remove="App_Data\**\*" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Content Update="appsettings.Development.json"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The vision extractor reads this policy at runtime. Keep it beside AURA.dll
       in both local build output and Web Deploy packages. -->
  <ItemGroup>
    <None Update="BUSINESS_RULES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Public Vietnamese reference for judges. It must never become a runtime
         policy candidate or be included in a deployment package. -->
    <None Update="docs\BUSINESS_RULES_VI.md"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
